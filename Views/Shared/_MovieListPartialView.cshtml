@{
}
@model List<Movie>
<h2 class="section-title">PHIM ĐANG CHIẾU</h2>
<div class="movie-grid">

    @foreach(var item in Model) 
    {
        <a asp-action="Detail" asp-route-id="@item.MovieId" asp-controller="Movie">
            <div class="movie-card">
                <div class="movie-img">
                    <img src="@item.PosterUrl" alt="@item.Title">
                    <div class="overlay">
                        <button class="btn-ticket">MUA VÉ</button>
                    </div>
                </div>
                <div class="movie-info">
                    <h3>@item.Title</h3>
                    <p>Thieu category</p>
                    <p>Thời lượng: @item.DurationMin</p>
                </div>
            </div>
        </a>
        
    }
</div>

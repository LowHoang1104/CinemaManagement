<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>PRIME NINE Cinema - Template Bài Tập</title>
    <link rel="stylesheet" href="~/css/style.css">
   <link rel="stylesheet" href="~/css/info-pages.css">
    <link rel="stylesheet" href="~/css/movie-detail.css">
    <link rel="stylesheet" href="~/css/ticket-selection.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
</head>
<body>

   @{
      var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
      var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
      bool IsActive(string controller, string action)
      {
         return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
      }
   }

    <header>
    <div class="container">
    <div class="logo">
 <a href="@Url.Action("Index", "Home")" aria-label="Về trang chủ">
 <img src="~/images/prime-nine-logo.png" alt="Prime Nine Cinema Logo">
 </a>
 </div>
        
    <!-- Cinema Selector Dropdown -->
 <div class="cinema-selector">
   <button class="cinema-selector-btn" id="cinemaSelectorBtn">
  <span id="selectedCinemaName">Chọn cơ sở</span>
     <span class="arrow">▼</span>
       </button>
     <div class="cinema-dropdown" id="cinemaDropdown">
       @{
         var cinemas = ViewData["Cinemas"] as List<Cinema> ?? new List<Cinema>();
            }
        @if (cinemas.Any())
   {
   @foreach (var cinema in cinemas)
              {
       <a href="javascript:void(0);" class="cinema-option" data-cinema-id="@cinema.CinemaId" data-cinema-name="@cinema.Name">
      @cinema.Name
      </a>
      }
         }
           else
     {
        <span class="cinema-option-disabled">Không có rạp nào</span>
   }
           </div>
       </div>
   
      <nav>
       <ul>
   <li><a href="@Url.Action("Index", "Home")" class="@(IsActive("Home", "Index") ? "active" : "")">LỊCH CHIẾU</a></li>
   <li><a href="@Url.Action("CinemaSystem", "Info")" class="@(IsActive("Info", "CinemaSystem") ? "active" : "")">HỆ THỐNG RẠP</a></li>
   <li><a href="@Url.Action("Index", "Movie")" class="@(IsActive("Movie", "Index") ? "active" : "")">PHIM</a></li>
   <li><a href="@Url.Action("TicketPrices", "Info")" class="@(IsActive("Info", "TicketPrices") ? "active" : "")">GIÁ VÉ</a></li>
   <li><a href="@Url.Action("NewsPromotions", "Info")" class="@(IsActive("Info", "NewsPromotions") ? "active" : "")">TIN MỚI VÀ ƯU ĐÃI</a></li>
   <li><a href="@Url.Action("Franchise", "Info")" class="@(IsActive("Info", "Franchise") ? "active" : "")">NHƯỢNG QUYỀN</a></li>
          </ul>
            </nav>
            <div class="user-actions">
            @if (User?.Identity?.IsAuthenticated == true)
            {
               <button class="btn-login" type="button" onclick="window.location.href='@Url.Action("Profile", "Auth")'">HỒ SƠ</button>
               <button class="btn-login btn-logout" type="button" onclick="window.location.href='@Url.Action("Logout", "Auth")'">ĐĂNG XUẤT</button>
            }
            else
            {
               <button class="btn-login" type="button" onclick="window.location.href='@Url.Action("Login", "Auth")'">ĐĂNG NHẬP</button>
            }

            </div>
        </div>
    </header>

    @RenderBody()

    <footer>
        <div class="container footer-content">
     <div class="footer-col">
        <h4>GIỚI THIỆU</h4>
   <ul>
        <li><a href="#">Về chúng tôi</a></li>
    <li><a href="#">Thỏa thuận sử dụng</a></li>
          <li><a href="#">Quy chế hoạt động</a></li>
       <li><a href="#">Chính sách bảo mật</a></li>
      </ul>
     </div>
   <div class="footer-col">
     <h4>GÓC ĐIỆN ẢNH</h4>
  <ul>
     <li><a href="#">Thể loại phim</a></li>
       <li><a href="#">Bình luận phim</a></li>
          <li><a href="#">Blog điện ảnh</a></li>
       </ul>
</div>
  <div class="footer-col">
      <h4>KẾT NỐI VỚI CHÚNG TÔI</h4>
   <p>Hotline: 1900 6467</p>
   <p>Email: marketing@primeninecinema.vn</p>
    </div>
        </div>
        <div class="footer-bottom">
   <p>&copy; 2024 PRIME NINE Cinema. All Rights Reserved. Design for School Project.</p>
   </div>
    </footer>
    <script>
   // Cinema Selector Dropdown Logic with Session
document.addEventListener('DOMContentLoaded', function() {
            const cinemaSelectorBtn = document.getElementById('cinemaSelectorBtn');
 const cinemaDropdown = document.getElementById('cinemaDropdown');
    const cinemaOptions = document.querySelectorAll('.cinema-option');
const selectedCinemaName = document.getElementById('selectedCinemaName');

       // Load selected cinema from session on page load
      loadSelectedCinema();

   // Toggle dropdown
cinemaSelectorBtn.addEventListener('click', function(e) {
         e.stopPropagation();
     cinemaDropdown.classList.toggle('active');
      });

    // Select cinema and save to session
 cinemaOptions.forEach(option => {
        option.addEventListener('click', function(e) {
       e.preventDefault();
          const cinemaName = this.getAttribute('data-cinema-name');
     const cinemaId = this.getAttribute('data-cinema-id');
    
   // Save to session via API
         saveCinemaToSession(cinemaId, cinemaName);
  });
      });

     // Close dropdown when clicking outside
         document.addEventListener('click', function(e) {
     if (!e.target.closest('.cinema-selector')) {
           cinemaDropdown.classList.remove('active');
}
});

      // Load selected cinema from session
            function loadSelectedCinema() {
   fetch('/Home/GetSelectedCinema', {
   method: 'GET',
          headers: {
        'Content-Type': 'application/json',
      }
       })
       .then(response => {
                if (!response.ok) {
     throw new Error('Network response was not ok');
    }
       return response.json();
            })
        .then(data => {
            if (data.cinemaName && data.cinemaName !== 'Chưa chọn cơ sở') {
        selectedCinemaName.textContent = data.cinemaName;
     } else {
    selectedCinemaName.textContent = 'Chọn cơ sở';
         }
    })
        .catch(error => {
           console.error('Error loading cinema:', error);
         selectedCinemaName.textContent = 'Chọn cơ sở';
       });
 }

     // Save cinema to session
         function saveCinemaToSession(cinemaId, cinemaName) {
   fetch('/Home/SelectCinema', {
     method: 'POST',
        headers: {
     'Content-Type': 'application/json',
        },
      body: JSON.stringify({ cinemaId: cinemaId })
      })
 .then(response => {
     if (!response.ok) {
        throw new Error('Network response was not ok');
     }
                return response.json();
            })
     .then(data => {
 if (data.success) {
   selectedCinemaName.textContent = data.cinemaName;
         cinemaDropdown.classList.remove('active');
   
      // Reload page after 500ms to apply cinema filter
          setTimeout(() => {
  window.location.reload();
          }, 300);
  } else {
    alert('Lỗi: ' + (data.message || 'Không thể chọn cơ sở'));
      }
 })
  .catch(error => {
  console.error('Error saving cinema:', error);
     alert('Có lỗi xảy ra khi chọn cơ sở');
   });
    }
  });
    </script>
</body>
</html>
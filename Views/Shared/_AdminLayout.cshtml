@using Microsoft.AspNetCore.Mvc.Rendering
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 70px;
            --sidebar-bg: #1a1d21;
            --sidebar-hover: #2d3238;
            --sidebar-active: #3b82f6;
            --sidebar-text: #a1a7b3;
            --sidebar-text-active: #ffffff;
            --navbar-height: 64px;
            --transition-speed: 0.3s;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            overflow-x: hidden;
        }

        /* ========== Sidebar Styles ========== */
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            z-index: 1050;
            transition: width var(--transition-speed) ease;
            display: flex;
            flex-direction: column;
        }

            .admin-sidebar.collapsed {
                width: var(--sidebar-collapsed-width);
            }

        /* Sidebar Brand/Logo */
        .sidebar-brand {
            height: var(--navbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

            .sidebar-brand .brand-icon {
                width: 38px;
                height: 38px;
                background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 1.25rem;
                flex-shrink: 0;
            }

            .sidebar-brand .brand-text {
                margin-left: 0.875rem;
                font-size: 1.25rem;
                font-weight: 700;
                color: #fff;
                white-space: nowrap;
                opacity: 1;
                transition: opacity var(--transition-speed) ease;
            }

        .admin-sidebar.collapsed .brand-text {
            opacity: 0;
            pointer-events: none;
        }

        /* Sidebar Navigation */
        .sidebar-nav {
            flex: 1;
            padding: 1rem 0.75rem;
            overflow-y: auto;
            overflow-x: hidden;
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.1);
                border-radius: 4px;
            }

        .nav-section-title {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: rgba(255, 255, 255, 0.35);
            padding: 0.75rem 0.75rem 0.5rem;
            margin-top: 0.5rem;
            white-space: nowrap;
            opacity: 1;
            transition: opacity var(--transition-speed) ease;
        }

        .admin-sidebar.collapsed .nav-section-title {
            opacity: 0;
        }

        .nav-item {
            margin-bottom: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 0.875rem;
            color: var(--sidebar-text);
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
        }

            .nav-link:hover {
                color: var(--sidebar-text-active);
                background: var(--sidebar-hover);
            }

            .nav-link.active {
                color: var(--sidebar-text-active);
                background: linear-gradient(90deg, var(--sidebar-active) 0%, #6366f1 100%);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35);
            }

            .nav-link .nav-icon {
                width: 22px;
                height: 22px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
                flex-shrink: 0;
            }

            .nav-link .nav-text {
                margin-left: 0.875rem;
                font-size: 0.9rem;
                font-weight: 500;
                white-space: nowrap;
                opacity: 1;
                transition: opacity var(--transition-speed) ease;
            }

        .admin-sidebar.collapsed .nav-text {
            opacity: 0;
            pointer-events: none;
        }

        .nav-link .badge {
            margin-left: auto;
            font-size: 0.7rem;
            padding: 0.25em 0.6em;
            opacity: 1;
            transition: opacity var(--transition-speed) ease;
        }

        .admin-sidebar.collapsed .nav-link .badge {
            opacity: 0;
        }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

            .sidebar-footer .user-info {
                display: flex;
                align-items: center;
            }

            .sidebar-footer .user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 600;
                font-size: 0.9rem;
                flex-shrink: 0;
            }

            .sidebar-footer .user-details {
                margin-left: 0.75rem;
                overflow: hidden;
                opacity: 1;
                transition: opacity var(--transition-speed) ease;
            }

        .admin-sidebar.collapsed .user-details {
            opacity: 0;
            pointer-events: none;
        }

        .sidebar-footer .user-name {
            font-size: 0.875rem;
            font-weight: 600;
            color: #fff;
            white-space: nowrap;
        }

        .sidebar-footer .user-role {
            font-size: 0.75rem;
            color: var(--sidebar-text);
            white-space: nowrap;
        }

        /* ========== Top Navbar Styles ========== */
        .admin-navbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: var(--navbar-height);
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            z-index: 1040;
            transition: left var(--transition-speed) ease;
        }

            .admin-navbar.expanded {
                left: var(--sidebar-collapsed-width);
            }

        .navbar-toggle {
            width: 38px;
            height: 38px;
            border: none;
            background: #f4f6f9;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4b5563;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .navbar-toggle:hover {
                background: #e5e7eb;
                color: #1f2937;
            }

        .navbar-search {
            flex: 1;
            max-width: 400px;
            margin-left: 1.5rem;
        }

            .navbar-search .input-group {
                background: #f4f6f9;
                border-radius: 8px;
                overflow: hidden;
            }

            .navbar-search .form-control {
                border: none;
                background: transparent;
                padding: 0.625rem 1rem;
                font-size: 0.875rem;
            }

                .navbar-search .form-control:focus {
                    box-shadow: none;
                }

            .navbar-search .input-group-text {
                border: none;
                background: transparent;
                color: #9ca3af;
            }

        .navbar-actions {
            display: flex;
            align-items: center;
            margin-left: auto;
            gap: 0.5rem;
        }

        .navbar-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6b7280;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }

            .navbar-btn:hover {
                background: #f4f6f9;
                color: #1f2937;
            }

            .navbar-btn .notification-badge {
                position: absolute;
                top: 6px;
                right: 6px;
                width: 8px;
                height: 8px;
                background: #ef4444;
                border-radius: 50%;
                border: 2px solid #fff;
            }

        .user-dropdown .dropdown-toggle {
            display: flex;
            align-items: center;
            padding: 0.375rem 0.75rem;
            border: none;
            background: #f4f6f9;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .user-dropdown .dropdown-toggle:hover {
                background: #e5e7eb;
            }

            .user-dropdown .dropdown-toggle::after {
                margin-left: 0.5rem;
            }

        .user-dropdown .user-avatar-sm {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            font-size: 0.75rem;
        }

        .user-dropdown .user-name-sm {
            margin-left: 0.625rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #1f2937;
        }

        .user-dropdown .dropdown-menu {
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
            border-radius: 10px;
            padding: 0.5rem;
            min-width: 200px;
        }

        .user-dropdown .dropdown-item {
            padding: 0.625rem 1rem;
            border-radius: 6px;
            font-size: 0.875rem;
            color: #4b5563;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

            .user-dropdown .dropdown-item:hover {
                background: #f4f6f9;
                color: #1f2937;
            }

            .user-dropdown .dropdown-item.text-danger:hover {
                background: #fef2f2;
                color: #dc2626;
            }

        .user-dropdown .dropdown-divider {
            margin: 0.375rem 0;
        }

        /* ========== Main Content Styles ========== */
        .admin-main {
            margin-left: var(--sidebar-width);
            margin-top: var(--navbar-height);
            min-height: calc(100vh - var(--navbar-height));
            padding: 1.5rem;
            transition: margin-left var(--transition-speed) ease;
            display: flex;
            flex-direction: column;
        }

            .admin-main.expanded {
                margin-left: var(--sidebar-collapsed-width);
            }

            .admin-main .content-wrapper {
                flex: 1;
            }

        /* ========== Footer Styles ========== */
        .admin-footer {
            padding: 1.25rem 0;
            margin-top: 2rem;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            font-size: 0.8125rem;
        }

            .admin-footer a {
                color: #3b82f6;
                text-decoration: none;
            }

                .admin-footer a:hover {
                    text-decoration: underline;
                }

        /* ========== Mobile Responsiveness ========== */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1045;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

                .admin-sidebar.mobile-open {
                    transform: translateX(0);
                }

            .sidebar-overlay.show {
                display: block;
            }

            .admin-navbar {
                left: 0;
            }

            .admin-main {
                margin-left: 0;
            }

            .navbar-search {
                display: none;
            }
        }

        @@media (max-width: 575.98px) {
            .user-dropdown .user-name-sm {
                display: none;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("_AdminSidebar")

    <!-- Top Navbar -->
    <header class="admin-navbar" id="adminNavbar">
        <button class="navbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <div class="navbar-search">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="Search cinemas, movies, bookings..." />
            </div>
        </div>

        <div class="navbar-actions">
            <button class="navbar-btn" aria-label="Notifications">
                <i class="bi bi-bell fs-5"></i>
                <span class="notification-badge"></span>
            </button>
            <button class="navbar-btn" aria-label="Messages">
                <i class="bi bi-chat-dots fs-5"></i>
            </button>

            <div class="dropdown user-dropdown">
                <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar-sm">AD</div>
                    <span class="user-name-sm">Admin</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person"></i>
                            My Profile
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Account" asp-action="Settings">
                            <i class="bi bi-gear"></i>
                            Account Settings
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                            Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="admin-main" id="adminMain">
        <div class="content-wrapper">
            @RenderBody()
        </div>

        <!-- Global Toast Container -->
        <div id="ToastContainer" class="fixed top-20 right-6 z-[9999] flex flex-col gap-3 pointer-events-none"></div>

        <!-- Footer -->
        <footer class="admin-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                <div>
                    &copy; @DateTime.Now.Year <strong>CinemaAdmin</strong>. All rights reserved.
                </div>
                <div class="mt-2 mt-md-0">
                    <a href="#">Privacy Policy</a>
                    <span class="mx-2">|</span>
                    <a href="#">Terms of Service</a>
                    <span class="mx-2">|</span>
                    <a href="#">Support</a>
                </div>
            </div>
        </footer>
    </main>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Sidebar Toggle Functionality
        const sidebar = document.getElementById('adminSidebar');
        const navbar = document.getElementById('adminNavbar');
        const main = document.getElementById('adminMain');
        const toggle = document.getElementById('sidebarToggle');
        const overlay = document.getElementById('sidebarOverlay');

        function isMobile() {
            return window.innerWidth < 992;
        }

        toggle.addEventListener('click', function () {
            if (isMobile()) {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('show');
            } else {
                sidebar.classList.toggle('collapsed');
                navbar.classList.toggle('expanded');
                main.classList.toggle('expanded');
            }
        });

        overlay.addEventListener('click', function () {
            sidebar.classList.remove('mobile-open');
            overlay.classList.remove('show');
        });

        // Close mobile sidebar on window resize
        window.addEventListener('resize', function () {
            if (!isMobile()) {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('show');
            }
        });

        /* ========== Global Toast System ========== */
        function showToast(title, message, type = 'success') {
            const container = document.getElementById('ToastContainer');
            if (!container) return;
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
            const icon = type === 'success' 
                ? '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>'
                : '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';

            const toastHtml = `
                <div id="${toastId}" class="flex items-center gap-4 p-4 min-w-[320px] max-w-[420px] bg-white border border-slate-200 rounded-2xl shadow-xl translate-x-[120%] transition-all duration-500 ease-out z-[3000] pointer-events-auto">
                    <div class="flex-shrink-0 w-10 h-10 ${bgColor} text-white rounded-xl flex items-center justify-center shadow-lg">
                        ${icon}
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-bold text-slate-900 truncate">${title}</h4>
                        <p class="text-xs text-slate-500 font-medium mt-0.5 break-words">${message}</p>
                    </div>
                    <button onclick="dismissToast('${toastId}')" class="text-slate-400 hover:text-slate-600 transition-colors">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toast = document.getElementById(toastId);
            
            // Trigger animation
            setTimeout(() => {
                toast.classList.remove('translate-x-[120%]');
            }, 10);

            // Auto dismiss
            setTimeout(() => dismissToast(toastId), 5000);
        }

        window.showToast = showToast;

        window.dismissToast = function(id) {
            const toast = document.getElementById(id);
            if (!toast) return;
            toast.classList.add('translate-x-[120%]', 'opacity-0');
            setTimeout(() => toast.remove(), 500);
        }

        // --- Render TempData messages as toasts ---
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Success"] != null)
            {
                <text>showToast('Thành công', '@Html.Raw(TempData["Success"]?.ToString()?.Replace("'", "\\'"))', 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showToast('Lỗi', '@Html.Raw(TempData["Error"]?.ToString()?.Replace("'", "\\'"))', 'error');</text>
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

@model CinemaManagement.ViewModels.Admin.UserListVm
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1">User Management</h4>
        <p class="text-muted mb-0 small">Manage accounts, roles, and access permissions</p>
    </div>
    <a asp-controller="AdminUsers" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-person-plus"></i> Create User
    </a>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Keyword</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Email / Name..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Role</label>
                <select name="role" class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var r in Model.AllRoles)
                    {
                        <option value="@r" selected="@(Model.Role == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="1" selected="@(Model.Status == 1)">Active</option>
                    <option value="0" selected="@(Model.Status == 0)">Locked</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
        <span class="fw-semibold"><i class="bi bi-people me-2 text-primary"></i>Users</span>
        <span class="badge bg-secondary rounded-pill">@Model.Items.Count total</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No users found.
                            </td>
                        </tr>
                    }
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var u = Model.Items[i];
                        <tr>
                            <td class="ps-4 text-muted small">@(i + 1)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold"
                                         style="width:34px;height:34px;font-size:13px">
                                        @(u.FullName?.Length > 0 ? u.FullName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <strong>@u.FullName</strong>
                                </div>
                            </td>
                            <td class="text-muted">@u.Email</td>
                            <td class="text-muted">@(u.Phone ?? "—")</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge rounded-pill me-1" style="background:#eaf0fb;color:#2980b9">@r</span>
                                }
                            </td>
                            <td>
                                @if (u.Status == 1)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                }
                                else if (u.Status == 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">Deleted</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-controller="AdminUsers" asp-action="Edit" asp-route-id="@u.UserId"
                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="AdminUsers" asp-action="AssignRoles" asp-route-id="@u.UserId"
                                       class="btn btn-sm btn-outline-secondary" title="Assign Roles">
                                        <i class="bi bi-shield-check"></i>
                                    </a>
                                    <form method="post" asp-controller="AdminUsers" asp-action="ToggleLock" asp-route-id="@u.UserId" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        @if (u.Status == 1)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Lock" onclick="return confirm('Lock this user?')">
                                                <i class="bi bi-lock"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Unlock">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        }
                                    </form>
                                    <form method="post" asp-controller="AdminUsers" asp-action="Delete" asp-route-id="@u.UserId" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"
                                                onclick="return confirm('Delete this user?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

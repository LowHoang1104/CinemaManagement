@model CinemaManagement.ViewModels.Admin.AssignRolesVm
@{
    ViewData["Title"] = "Assign Roles";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="AdminUsers" asp-action="Index">User Management</a></li>
            <li class="breadcrumb-item active">Assign Roles</li>
        </ol>
    </nav>
    <h4 class="fw-bold mb-0">Assign Roles</h4>
</div>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-shield-check me-2 text-primary"></i>Role Assignment</h6>
                <small class="text-muted">User: <strong>@Model.Email</strong></small>
            </div>
            <div class="card-body p-4">
                <form method="post" action="/AdminUsers/AssignRoles">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.UserId" />

                    <div class="d-flex flex-column gap-2 mb-4">
                        @foreach (var role in Model.Roles)
                        {
                            <div class="form-check p-3 rounded border d-flex align-items-center gap-2 @(role.Selected ? "border-primary bg-primary bg-opacity-10" : "")"
                                 style="background:@(role.Selected ? "" : "#f8f9fa")">
                                <input class="form-check-input" type="checkbox" id="role_@role.RoleId"
                                       name="selectedRoleIds" value="@role.RoleId"
                                       @(role.Selected ? "checked" : "") />
                                <label class="form-check-label fw-medium" for="role_@role.RoleId">
                                    <i class="bi bi-person-badge me-2 text-muted"></i>@role.Name
                                </label>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-check-lg me-1"></i>Save Roles
                        </button>
                        <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-secondary">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

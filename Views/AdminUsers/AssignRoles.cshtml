@model CinemaManagement.ViewModels.Admin.AssignRolesVm
@{
    ViewData["Title"] = "Assign Roles";
}

<style>
    .form-wrap {
        max-width: 520px;
        margin: 32px auto;
        padding: 0 16px;
    }

    .card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0,0,0,.1);
        padding: 28px 32px;
    }

        .card h3 {
            margin: 0 0 6px;
            color: #c0392b;
        }

        .card .sub {
            font-size: 13px;
            color: #888;
            margin-bottom: 20px;
        }

    .role-list {
        list-style: none;
        padding: 0;
        margin: 0 0 20px;
    }

        .role-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 6px;
            margin-bottom: 8px;
            background: #f8f9fa;
        }

            .role-list li:hover {
                background: #eaf0fb;
            }

        .role-list input[type=checkbox] {
            width: 17px;
            height: 17px;
            accent-color: #e50914;
            cursor: pointer;
        }

        .role-list label {
            font-size: 14px;
            color: #333;
            cursor: pointer;
            font-weight: 500;
        }

    .btn-row {
        display: flex;
        gap: 10px;
    }

    .btn {
        padding: 8px 20px;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-primary {
        background: #e50914;
        color: #fff;
    }

    .btn-secondary {
        background: #95a5a6;
        color: #fff;
    }
</style>

<div class="form-wrap">
    <div class="card">
        <h3>Assign Roles</h3>
        <p class="sub">User: <strong>@Model.Email</strong></p>

        <form method="post" action="/AdminUsers/AssignRoles">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.UserId" />

            <ul class="role-list">
                @foreach (var role in Model.Roles)
                {
                    <li>
                        <input type="checkbox" id="role_@role.RoleId"
                               name="selectedRoleIds" value="@role.RoleId"
                               @(role.Selected ? "checked" : "") />
                        <label for="role_@role.RoleId">@role.Name</label>
                    </li>
                }
            </ul>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="/AdminUsers" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

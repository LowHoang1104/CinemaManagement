@model CinemaManagement.ViewModels.Admin.CreateUserVm
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="AdminUsers" asp-action="Index">User Management</a></li>
            <li class="breadcrumb-item active">Create User</li>
        </ol>
    </nav>
    <h4 class="fw-bold mb-0">Create New User</h4>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-person-plus me-2 text-primary"></i>User Information</h6>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input type="email" name="Email" value="@Model.Email" class="form-control" placeholder="user@example.com" />
                        <span class="text-danger small">@Html.ValidationMessage("Email")</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                        <input type="password" name="Password" class="form-control" placeholder="Min 6 characters" />
                        <span class="text-danger small">@Html.ValidationMessage("Password")</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" value="@Model.FullName" class="form-control" placeholder="Nguyen Van A" />
                        <span class="text-danger small">@Html.ValidationMessage("FullName")</span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone</label>
                        <input type="text" name="Phone" value="@Model.Phone" class="form-control" placeholder="0901234567" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Roles</label>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var role in Model.AllRoles)
                            {
                                <div class="form-check p-3 rounded border d-flex align-items-center gap-2" style="background:#f8f9fa">
                                    <input class="form-check-input" type="checkbox" id="role_@role.RoleId"
                                           name="SelectedRoleIds" value="@role.RoleId" />
                                    <label class="form-check-label fw-medium" for="role_@role.RoleId">@role.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-check-lg me-1"></i>Create User
                        </button>
                        <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model CinemaManagement.Models.Room

@{
    ViewData["Title"] = "Chỉnh Sửa Phòng Chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cinemaName = ViewData["CinemaName"] as string;
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-slate-50/80 py-8">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">

        @* ── Breadcrumb ── *@
        <nav class="mb-4 flex items-center gap-1.5 text-xs text-slate-400">
            <a asp-controller="Home"   asp-action="Index" class="hover:text-indigo-600 transition-colors">Dashboard</a>
            <span>/</span>
            <a asp-controller="Cinemas" asp-action="Index" class="hover:text-indigo-600 transition-colors">Rạp chiếu phim</a>
            <span>/</span>
            <a asp-controller="Rooms"  asp-action="Index" class="hover:text-indigo-600 transition-colors">Phòng chiếu</a>
            <span>/</span>
            <span class="text-slate-600 font-medium">Chỉnh sửa</span>
        </nav>

        @* ── Page Header ── *@
        <div class="mb-8 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600"
                     fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.89 1.12l-2.686.895.895-2.686a4.5 4.5 0 011.12-1.89l12.593-12.593z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125L16.875 4.5"/>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">
                    Chỉnh Sửa Phòng: <span class="text-indigo-600">@Model.Name</span>
                </h1>
                <p class="mt-0.5 text-sm text-slate-400">Chỉ có thể thay đổi tên phòng chiếu</p>
            </div>
        </div>

        <form asp-action="Edit" method="post" id="editRoomForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RoomId" />

            <div class="space-y-5">

                @* Validation summary *@
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4">
                        <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                        </svg>
                        <div>
                            <p class="mb-1 text-sm font-semibold text-red-700">Vui lòng kiểm tra lại thông tin:</p>
                            <asp-validation-summary asp-validation-summary="All"
                                                    class="text-xs text-red-600 space-y-0.5" />
                        </div>
                    </div>
                }

                @* ── 01 · Thông tin có thể thay đổi ── *@
                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
                    <div class="border-b border-slate-100 bg-slate-50/60 px-5 py-3">
                        <p class="text-[11px] font-bold uppercase tracking-widest text-indigo-600">
                            01 — Thông Tin Có Thể Thay Đổi
                        </p>
                    </div>
                    <div class="px-5 py-5">
                        <label asp-for="Name" class="mb-1.5 block text-sm font-medium text-slate-800">
                            Tên phòng chiếu <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Name"
                               autocomplete="off" required
                               class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5
                                      text-sm text-slate-900 outline-none placeholder:text-slate-400
                                      focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100
                                      transition" />
                        <span asp-validation-for="Name" class="mt-1 block text-xs text-red-600"></span>
                        <p class="mt-2 text-xs text-slate-400">
                            Được phép thay đổi. Tên phòng phải duy nhất trong rạp.
                        </p>
                    </div>
                </div>

                @* ── 02 · Thông số kỹ thuật (read-only) ── *@
                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
                    <div class="border-b border-slate-100 bg-slate-50/60 px-5 py-3">
                        <p class="text-[11px] font-bold uppercase tracking-widest text-slate-400">
                            02 — Thông Số Kỹ Thuật
                            <span class="ml-1.5 rounded-full bg-slate-200 px-2 py-0.5 text-[9px] font-semibold uppercase text-slate-500">
                                Chỉ đọc
                            </span>
                        </p>
                    </div>
                    <div class="px-5 py-5 space-y-5">

                        @* Rạp chiếu phim *@
                        <div>
                            <label class="mb-1.5 block text-sm font-medium text-slate-500">Rạp chiếu phim</label>
                            <div class="flex items-center gap-2.5 rounded-xl border border-slate-200 bg-slate-100 px-3.5 py-2.5">
                                <svg class="h-4 w-4 flex-shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" stroke-width="2">
                                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                                    <circle cx="12" cy="9" r="2.5"/>
                                </svg>
                                <span class="text-sm font-semibold text-slate-600">@cinemaName</span>
                            </div>
                        </div>

                        @* Số hàng / cột *@
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-slate-500">Số hàng ghế</label>
                                <div class="flex items-center justify-center rounded-xl border border-slate-200
                                            bg-slate-100 py-2.5 text-center text-base font-bold text-slate-500
                                            cursor-not-allowed select-none">
                                    @Model.TotalRows
                                </div>
                            </div>
                            <div>
                                <label class="mb-1.5 block text-sm font-medium text-slate-500">Số cột ghế</label>
                                <div class="flex items-center justify-center rounded-xl border border-slate-200
                                            bg-slate-100 py-2.5 text-center text-base font-bold text-slate-500
                                            cursor-not-allowed select-none">
                                    @Model.TotalCols
                                </div>
                            </div>
                        </div>

                        @* Info badge: tổng ghế *@
                        <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-slate-200/70">
                                <svg class="h-4 w-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 9V6a2 2 0 00-2-2H6a2 2 0 00-2 2v3"/>
                                    <path d="M2 11v5a2 2 0 002 2h16a2 2 0 002-2v-5a2 2 0 00-4 0v1H6v-1a2 2 0 00-4 0z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-xs text-slate-400">Tổng sức chứa</p>
                                <p class="text-sm font-bold text-slate-700">
                                    @(Model.TotalRows * Model.TotalCols) ghế
                                    <span class="font-normal text-slate-400">
                                        (@Model.TotalRows × @Model.TotalCols)
                                    </span>
                                </p>
                            </div>
                        </div>

                        @* Warning *@
                        <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3">
                            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-amber-500" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                            </svg>
                            <p class="text-xs font-medium text-amber-700">
                                Kích thước phòng chiếu và số ghế không thể thay đổi sau khi khởi tạo để bảo vệ cấu trúc dữ liệu vé.
                            </p>
                        </div>

                    </div>
                </div>

                @* ── Actions ── *@
                <div class="flex flex-wrap items-center gap-3 pt-1">
                    <button type="submit" id="submitBtn"
                            class="inline-flex min-w-[160px] items-center justify-center gap-2 rounded-xl
                                   bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm
                                   hover:bg-indigo-700 hover:-translate-y-px hover:shadow-indigo-200/60 hover:shadow-lg
                                   active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-70
                                   transition-all focus-visible:outline-none focus-visible:ring-2
                                   focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                        </svg>
                        <span id="btnText">Lưu Thay Đổi</span>
                    </button>

                    <a asp-action="Index"
                       class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-5 py-3
                              text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400
                              transition-colors">
                        Hủy
                    </a>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form      = document.getElementById('editRoomForm');
            const submitBtn = document.getElementById('submitBtn');
            const btnText   = document.getElementById('btnText');

            form.addEventListener('submit', function () {
                if (form.checkValidity()) {
                    submitBtn.disabled = true;
                    btnText.textContent = 'Đang lưu...';
                }
            });
        })();
    </script>
}

@model CinemaManagement.ViewModels.Rooms.RoomListViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý phòng chiếu";

    var cinemas = ViewData["CinemaSelectList"] as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    bool hasFilters = Model.CinemaIdFilter.HasValue || Model.StatusFilter.HasValue ||
!string.IsNullOrWhiteSpace(Model.SearchTerm);
}

<script src="https://cdn.tailwindcss.com"></script>

@* Using global ToastContainer from Shared/_AdminLayout.cshtml *@

<div class="min-h-screen bg-slate-50/80 py-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-6">
        @* ── Header ── *@
        <div class="flex items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    Quản lý phòng chiếu
                </h1>
                <p class="mt-1 text-sm text-slate-500">
                    Quản lý phòng chiếu và sơ đồ ghế ngồi
                </p>
            </div>
            <a asp-action="Create"
                   class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Thêm phòng mới
            </a>
        </div>

        @* ── Stats ── *@
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4 mt-8">
            @* Tổng phòng *@
            <div
                class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-500 shadow-sm border border-indigo-100/50">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <path d="M3 9h18M9 21V9" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">Tổng số phòng</p>
                        <p class="text-2xl font-black text-slate-900 leading-tight">@Model.TotalRooms</p>
                    </div>
                </div>
            </div>
            @* Hoạt động *@
            <div
                class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-500 shadow-sm border border-emerald-100/50">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                            <circle cx="12" cy="12" r="9" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">Hoạt động</p>
                        <p class="text-2xl font-black text-emerald-600 leading-tight">@Model.TotalActiveRooms</p>
                    </div>
                </div>
            </div>
            @* Ngừng hoạt động *@
            <div
                class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-rose-50 text-rose-500 shadow-sm border border-rose-100/50">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="9" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 9l-6 6M9 9l6 6" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">Ngừng / Bảo trì
                        </p>
                        <p class="text-2xl font-black text-rose-600 leading-tight">@Model.TotalInactiveRooms</p>
                    </div>
                </div>
            </div>
            @* Tổng số ghế *@
            <div
                class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-500 shadow-sm border border-amber-100/50">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M20 9V6a2 2 0 00-2-2H6a2 2 0 00-2 2v3" />
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2 11v5a2 2 0 002 2h16a2 2 0 002-2v-5a2 2 0 00-4 0v1H6v-1a2 2 0 00-4 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">Tổng số ghế</p>
                        <p class="text-2xl font-black text-amber-600 leading-tight">@Model.TotalSeats.ToString("N0")</p>
                    </div>
                </div>
            </div>
        </div>

        @* ── Filter Panel ── *@
        <div class="rounded-2xl border border-slate-200 bg-white px-5 py-4 mt-8 shadow-sm">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Bộ lọc & Tìm kiếm</p>

            <form id="roomFilterForm" method="get" asp-action="Index" class="space-y-3">
                @* Row 1: Search *@
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="7" />
                            <line x1="16.65" y1="16.65" x2="21" y2="21" />
                        </svg>
                    </span>
                    <input type="text" id="searchInput" name="search" value="@Model.SearchTerm"
                           placeholder="Tìm kiếm theo tên phòng, rạp chiếu..." autocomplete="off"
                           class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2.5 pl-9 pr-4 text-sm text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-400 focus:bg-white focus:ring-2 focus:ring-indigo-100 transition" />
                </div>

                @* Row 2: Selects + Buttons *@
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                    @* ── Cinema custom dropdown ── *@
                    @* ── Cinema custom dropdown ── *@
                    @{
                        var cinemaCurrent = Model.CinemaIdFilter.HasValue
                            ? (cinemas.FirstOrDefault(c => c.Value == Model.CinemaIdFilter.ToString())?.Text ?? "Tất cả rạp")
                            : "Tất cả rạp";
                    }
                    <input type="hidden" name="cinemaId" id="cinemaIdInput"
                           value="@(Model.CinemaIdFilter?.ToString() ?? "")" />
                    <div class="relative flex-1" data-filter-dropdown>
                        <button type="button" onclick="room_toggleFilterDropdown('cinemaPanel', event)"
                                class="flex w-full items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm hover:border-indigo-300 hover:bg-slate-50 transition-colors">
                            <svg class="h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                                <circle cx="12" cy="9" r="2.5" />
                            </svg>
                            <span id="cinemaLabel"
                                  class="flex-1 truncate text-left @(Model.CinemaIdFilter.HasValue ? "font-medium text-slate-900" : "text-slate-500")">@cinemaCurrent</span>
                            @if (Model.CinemaIdFilter.HasValue)
                            {
                                <span class="flex-shrink-0 rounded-full bg-indigo-100 p-0.5">
                                    <svg class="h-3 w-3 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <polyline points="2,6 5,9 10,3" />
                                    </svg>
                                </span>
                            }
                            <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                        <div id="cinemaPanel"
                             class="filter-dropdown-panel absolute left-0 top-full z-50 mt-1 hidden w-full min-w-[200px] overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                            @{
                                var isAllCinema = !Model.CinemaIdFilter.HasValue;
                            }
                            <button type="button"
                                    class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                    onclick="room_selectFilterOpt('cinemaPanel','cinemaIdInput','cinemaLabel','','Tất cả rạp',false, this)">
                                <span
                                    class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isAllCinema ? "" : "hidden")">
                                    <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                         stroke="currentColor" stroke-width="2.5">
                                        <polyline points="2,6 5,9 10,3" />
                                    </svg>
                                </span>
                                <span
                                    class="filter-text @(isAllCinema ? "font-semibold text-indigo-700" : "text-slate-600")">Tất
                                    cả rạp</span>
                            </button>
                            <div class="h-px bg-slate-100 mx-2"></div>
                            @foreach (var c in cinemas)
                            {
                                var isSel = c.Value == Model.CinemaIdFilter?.ToString();
                                <button type="button"
                                        class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                        onclick="room_selectFilterOpt('cinemaPanel','cinemaIdInput','cinemaLabel','@c.Value','@c.Text',true, this)">
                                    <span
                                        class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isSel ? "" : "hidden")">
                                        <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                             stroke="currentColor" stroke-width="2.5">
                                            <polyline points="2,6 5,9 10,3" />
                                        </svg>
                                    </span>
                                    <span
                                        class="filter-text @(isSel ? "font-semibold text-indigo-700" : "text-slate-600")">@c.Text</span>
                                </button>
                            }
                        </div>
                    </div>

                    @* ── Status custom dropdown ── *@
                    @{
                        var statusCurrent = Model.StatusFilter switch
                        {
                            RoomStatus.Active => "Hoạt động",
                            RoomStatus.Inactive => "Ngừng hoạt động",
                            _ => "Tất cả trạng thái"
                        };
                        var statusInputVal = Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString() : "";
                    }
                    <input type="hidden" name="status" id="statusInput" value="@statusInputVal" />
                    <div class="relative sm:w-52" data-filter-dropdown>
                        <button type="button" id="statusTrigger" onclick="room_toggleFilterDropdown('statusPanel', event)"
                                class="flex w-full items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm hover:border-indigo-300 hover:bg-slate-50 transition-colors">
                            <svg class="h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="9" />
                                <path d="M9 12l2 2 4-4" />
                            </svg>
                            <span id="statusLabel"
                                  class="flex-1 truncate text-left @(Model.StatusFilter.HasValue ? "font-medium text-slate-900" : "text-slate-500")">@statusCurrent</span>
                            @if (Model.StatusFilter.HasValue)
                            {
                                <span class="flex-shrink-0 rounded-full bg-indigo-100 p-0.5">
                                    <svg class="h-3 w-3 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <polyline points="2,6 5,9 10,3" />
                                    </svg>
                                </span>
                            }
                            <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                        <div id="statusPanel"
                             class="filter-dropdown-panel absolute left-0 top-full z-50 mt-1 hidden w-full min-w-[180px] overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                            @{
                                var isAllStatus = !Model.StatusFilter.HasValue;
                            }
                            <button type="button"
                                    class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                    onclick="room_selectFilterOpt('statusPanel', 'statusInput', 'statusLabel', '', 'Tất cả trạng thái', false, this)">
                                <span
                                    class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isAllStatus ? "" : "hidden")">
                                    @if (isAllStatus)
                                    {
                                        <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                             stroke="currentColor" stroke-width="2.5">
                                            <polyline points="2,6 5,9 10,3" />
                                        </svg>
                                    }
                                </span>
                                <span
                                    class="filter-text @(isAllStatus ? "font-semibold text-indigo-700" : "text-slate-600")">Tất
                                    cả trạng thái</span>
                            </button>
                            <div class="h-px bg-slate-100 mx-2"></div>
                            @{
                                var isActive = Model.StatusFilter == RoomStatus.Active;
                                var isInactive = Model.StatusFilter == RoomStatus.Inactive;
                            }
                            <button type="button"
                                    class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                    onclick="room_selectFilterOpt('statusPanel', 'statusInput', 'statusLabel', '1', 'Hoạt động', true, this)">
                                <span
                                    class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isActive ? "" : "hidden")">
                                    <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                         stroke="currentColor" stroke-width="2.5">
                                        <polyline points="2,6 5,9 10,3" />
                                    </svg>
                                </span>
                                <span
                                    class="filter-text flex items-center gap-2 @(isActive ? "font-semibold text-indigo-700" : "text-slate-600")">
                                    Hoạt động
                                </span>
                            </button>
                            <button type="button"
                                    class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                    onclick="room_selectFilterOpt('statusPanel', 'statusInput', 'statusLabel', '0', 'Ngừng hoạt động', true, this)">
                                <span
                                    class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isInactive ? "" : "hidden")">
                                    <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                         stroke="currentColor" stroke-width="2.5">
                                        <polyline points="2,6 5,9 10,3" />
                                    </svg>
                                </span>
                                <span
                                    class="filter-text flex items-center gap-2 @(isInactive ? "font-semibold text-indigo-700" : "text-slate-600")">
                                    Ngừng hoạt động
                                </span>
                            </button>
                        </div>
                    </div>

                            @* Action Buttons *@
                            <div class="flex gap-2 sm:flex-shrink-0">
                                <button type="submit"
                                        class="flex items-center gap-2 bg-slate-900 text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-slate-800 transition-all active:scale-[0.98] whitespace-nowrap">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                                    </svg>
                                    Lọc
                                </button>
                                <div id="ajax-clear-filter-wrapper">
                                    @if (hasFilters)
                                    {
                                        <a asp-action="Index"
                                               class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors">
                                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5">
                                                <line x1="18" y1="6" x2="6" y2="18" />
                                                <line x1="6" y1="6" x2="18" y2="18" />
                                            </svg>
                                            Xóa bộ lọc
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </form>

                    @* Active filter chips wrapper *@
                    <div id="ajax-chips-wrapper">
                        @if (hasFilters)
                        {
                            <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-3">
                                <span class="text-xs text-slate-400 font-medium">Đang lọc:</span>
                                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                                {
                                    <a href="/Rooms/Index?cinemaId=@(Model.CinemaIdFilter)&status=@(Model.StatusFilter)"
                                           class="inline-flex items-center gap-1 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-xs font-medium text-indigo-700 hover:bg-indigo-100 transition-colors">
                                        🔍 "@Model.SearchTerm"
                                        <span class="ml-0.5 text-indigo-400">×</span>
                                    </a>
                                }
                                @if (Model.CinemaIdFilter.HasValue)
                                {
                                    var cName = cinemas.FirstOrDefault(c => c.Value == Model.CinemaIdFilter.ToString())?.Text;
                                    <a href="/Rooms/Index?search=@Model.SearchTerm&status=@Model.StatusFilter"
                                           class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-xs font-medium text-blue-700 hover:bg-blue-100 transition-colors">
                                        📍 @cName
                                        <span class="ml-0.5 text-blue-400">×</span>
                                    </a>
                                }
                                @if (Model.StatusFilter.HasValue)
                                {
                                    var sName = Model.StatusFilter switch
                                    {
                                        RoomStatus.Active => "Hoạt động",
                                        RoomStatus.Inactive =>
                       "Ngừng hoạt động",
                                        _ => "Khác"
                                    };
                                    <a href="/Rooms/Index?search=@Model.SearchTerm&cinemaId=@Model.CinemaIdFilter"
                                           class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-xs font-medium text-emerald-700 hover:bg-emerald-100 transition-colors">
                                        @sName
                                        <span class="ml-0.5 text-emerald-400">×</span>
                                    </a>
                                }
                                <span class="ml-1 text-xs text-slate-400">— Tìm thấy <strong
                                    class="text-slate-600">@Model.TotalItems</strong> phòng</span>
                                    <a id="clearFilterBtn" href="/Rooms/Index"
                                           class="ml-auto text-xs font-bold text-slate-400 hover:text-slate-600 transition-colors">Xóa tất
                                        cả bộ lọc</a>
                                    </div>
                                }
                            </div>
                        </div>

                        <div id="room-list-container" class="mt-8">
                            @await Html.PartialAsync("_RoomListPartial", Model)
                        </div>

                    </div>
                </div>

                @* Modals for status toggle and edit *@
                @Html.AntiForgeryToken()
                <partial name="_StatusModals" />
                <partial name="_EditModal" />

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/admin/room-index.js" asp-append-version="true"></script>

    <style>
        .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #cbd5e1;
        }
    </style>
}


@model CinemaManagement.Models.Room
@{
    ViewData["Title"] = "Thêm Phòng Chiếu Mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var cinemaSelectList = ViewData["CinemaId"] as SelectList;
}

<script src="https://cdn.tailwindcss.com"></script>

@* ── Processing Overlay ──────────────────────────────────────────────────── *@
<div id="processingOverlay"
     role="status" aria-live="assertive" aria-atomic="true"
     class="hidden fixed inset-0 z-[9999] bg-slate-900/60 backdrop-blur-sm
            items-center justify-center flex-col">
    <div class="w-[90%] max-w-sm rounded-2xl bg-white p-10 text-center shadow-2xl
                animate-[popIn_.3s_cubic-bezier(.34,1.56,.64,1)_both]">
        <div class="mx-auto mb-5 h-14 w-14 rounded-full border-4 border-slate-200
                    border-t-indigo-600 animate-spin"></div>
        <h5 class="mb-1.5 text-base font-bold text-slate-900">Đang khởi tạo phòng chiếu...</h5>
        <p class="text-sm text-slate-500">
            Hệ thống đang tự động tạo
            <strong id="seatCountMsg" class="font-semibold text-indigo-600">0</strong>
            ghế ngồi. Vui lòng không đóng trang.
        </p>
        <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-slate-100">
            <div id="progressFill"
                 class="h-full rounded-full bg-gradient-to-r from-indigo-600 to-violet-500
                        animate-[fillBar_3s_ease-in-out_forwards]"></div>
        </div>
    </div>
</div>

<style>
    @@keyframes popIn {
        from { transform: scale(.88); opacity: 0; }
        to   { transform: scale(1);   opacity: 1; }
    }
    @@keyframes fillBar {
        0%   { width: 0%; }
        35%  { width: 55%; }
        70%  { width: 82%; }
        100% { width: 95%; }
    }
    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    input[type=number] { -moz-appearance: textfield; }
</style>

<div class="min-h-screen bg-slate-50/80 py-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        @* ── Back Link ── *@
        <a asp-action="Index" class="group mb-4 inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Quay lại danh sách phòng
        </a>

        @* ── Page Header ── *@
        <div class="mb-8 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600"
                     fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25A2.25 2.25 0 0113.5 8.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Thêm Phòng Chiếu Mới</h1>
        </div>

        <form asp-action="Create" method="post" id="createRoomForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="flex flex-col gap-6 lg:flex-row lg:items-start">

                @* ════ LEFT: Form ════════════════════════════════════════════ *@
                <div class="flex-1 min-w-0 space-y-5">

                    @* Validation summary *@
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4">
                            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                            </svg>
                            <div>
                                <p class="mb-1 text-sm font-semibold text-red-700">Vui lòng kiểm tra lại thông tin:</p>
                                <asp-validation-summary asp-validation-summary="All"
                                                        class="text-xs text-red-600 space-y-0.5" />
                            </div>
                        </div>
                    }

                    @* 01 · Chọn Rạp *@
                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
                        <div class="rounded-t-2xl border-b border-slate-100 bg-slate-50/60 px-5 py-3">
                            <p class="text-[11px] font-bold uppercase tracking-widest text-indigo-600">
                                01 — Chọn Rạp Chiếu Phim
                            </p>
                        </div>
                        <div class="px-5 py-5">
                            <label class="mb-2 block text-sm font-medium text-slate-800">
                                Rạp chiếu phim <span class="text-red-500">*</span>
                            </label>

                            @{
                                var selectedCinItem  = cinemaSelectList?.Cast<SelectListItem>()
                                    .FirstOrDefault(c => c.Selected || c.Value == Model?.CinemaId.ToString());
                                var selectedCinLabel = selectedCinItem?.Text  ?? "";
                                var selectedCinValue = selectedCinItem?.Value ?? "";
                                var hasSelectedCin   = !string.IsNullOrEmpty(selectedCinValue);
                            }

                            @* Hidden input — giá trị thực gửi lên server *@
                            <input type="hidden" name="CinemaId" id="CinemaId" value="@selectedCinValue" />

                            @* Trigger button *@
                            <div class="relative" id="cinemaDropdownRoot">
                                <button type="button" id="cinemaTrigger"
                                        onclick="toggleCinemaDropdown(event)"
                                        class="flex w-full items-center gap-2.5 rounded-xl border
                                               @(hasSelectedCin ? "border-indigo-300 bg-white" : "border-slate-200 bg-slate-50")
                                               px-3.5 py-2.5 text-sm shadow-sm
                                               hover:border-indigo-300 hover:bg-white
                                               focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100
                                               transition-colors">
                                    <svg class="h-4 w-4 flex-shrink-0 @(hasSelectedCin ? "text-indigo-500" : "text-slate-400")"
                                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                                        <circle cx="12" cy="9" r="2.5"/>
                                    </svg>
                                    <span id="cinemaLabel"
                                          class="flex-1 truncate text-left @(hasSelectedCin ? "font-medium text-slate-900" : "text-slate-400")">
                                        @(hasSelectedCin ? selectedCinLabel : "Chọn rạp")
                                    </span>
                                    @if (hasSelectedCin)
                                    {
                                        <span class="flex-shrink-0 rounded-full bg-indigo-100 p-0.5">
                                            <svg class="h-3 w-3 text-indigo-600" viewBox="0 0 12 12" fill="none"
                                                 stroke="currentColor" stroke-width="2.5">
                                                <polyline points="2,6 5,9 10,3"/>
                                            </svg>
                                        </span>
                                    }
                                    <svg id="cinemaChevron"
                                         class="h-3.5 w-3.5 flex-shrink-0 text-slate-400 transition-transform duration-150"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="6 9 12 15 18 9"/>
                                    </svg>
                                </button>

                                @* Dropdown panel *@
                                <div id="cinemaPanel"
                                     class="absolute left-0 top-full z-50 mt-1 hidden w-full
                                            overflow-hidden rounded-xl border border-slate-200 bg-white
                                            shadow-xl ring-1 ring-slate-900/5">
                                    <div class="max-h-60 overflow-y-auto py-1">
                                        @foreach (var c in cinemaSelectList ?? Enumerable.Empty<SelectListItem>())
                                        {
                                            var isSel = c.Value == selectedCinValue;
                                            <button type="button"
                                                    class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                                    onclick="selectCinema('@c.Value', '@c.Text', this)">
                                                <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isSel ? "" : "hidden")">
                                                    <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5">
                                                        <polyline points="2,6 5,9 10,3"/>
                                                    </svg>
                                                </span>
                                                <span class="filter-text @(isSel ? "font-semibold text-indigo-700" : "text-slate-600")">
                                                    @c.Text
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <p id="cinemaError" class="mt-1.5 hidden text-xs text-red-600">Vui lòng chọn rạp chiếu phim.</p>
                            <span asp-validation-for="CinemaId" class="mt-1 block text-xs text-red-600"></span>

                            <p class="mt-2 flex items-center gap-1 text-xs text-slate-400">
                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                                </svg>
                                Sau khi tạo, phòng chiếu không thể chuyển sang rạp khác.
                            </p>
                        </div>
                    </div>

                    @* 02 · Thông tin phòng *@
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
                        <div class="border-b border-slate-100 bg-slate-50/60 px-5 py-3">
                            <p class="text-[11px] font-bold uppercase tracking-widest text-indigo-600">
                                02 — Thông Tin Phòng Chiếu
                            </p>
                        </div>
                        <div class="px-5 py-5">
                            <label asp-for="Name" class="mb-1.5 block text-sm font-medium text-slate-800">
                                Tên phòng chiếu <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="Name" id="roomName"
                                   placeholder="VD: Phòng 1, IMAX 3D, Phòng VIP Tầng 2..."
                                   autocomplete="off" required
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5
                                          text-sm text-slate-900 outline-none placeholder:text-slate-400
                                          focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-100
                                          transition" />
                            <div id="roomNameFeedback" class="mt-1.5 hidden text-xs font-medium text-red-600"></div>
                            <p class="mt-2 text-xs text-slate-400">Tên phải là duy nhất trong phạm vi rạp đã chọn.</p>
                            <span asp-validation-for="Name" class="mt-1 block text-xs text-red-600"></span>
                        </div>
                    </div>

                    @* 03 · Cấu hình ghế *@
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
                        <div class="border-b border-slate-100 bg-slate-50/60 px-5 py-3">
                            <p class="text-[11px] font-bold uppercase tracking-widest text-indigo-600">
                                03 — Cấu Hình Sơ Đồ Ghế
                            </p>
                        </div>
                        <div class="px-5 py-5 space-y-5">
                            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                                @* Số hàng *@
                                <div>
                                    <label asp-for="TotalRows" class="mb-1.5 block text-sm font-medium text-slate-800">
                                        Số hàng ghế <span class="text-red-500">*</span>
                                    </label>
                                    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-slate-50
                                                focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-100
                                                transition">
                                        <button type="button" onclick="stepValue('TotalRows', -1)" aria-label="Giảm hàng"
                                                class="flex w-11 flex-shrink-0 items-center justify-center
                                                       text-slate-500 text-lg hover:bg-slate-100 hover:text-indigo-600
                                                       active:bg-indigo-50 transition-colors select-none">
                                            −
                                        </button>
                                        <input asp-for="TotalRows" type="number" id="TotalRows"
                                               min="1" max="26" required
                                               value="@(Model?.TotalRows > 0 ? Model.TotalRows : 10)"
                                               class="flex-1 min-w-0 border-0 bg-transparent py-2.5 text-center
                                                      text-base font-semibold text-slate-900 outline-none
                                                      focus:ring-0" />
                                        <button type="button" onclick="stepValue('TotalRows', 1)" aria-label="Tăng hàng"
                                                class="flex w-11 flex-shrink-0 items-center justify-center
                                                       text-slate-500 text-lg hover:bg-slate-100 hover:text-indigo-600
                                                       active:bg-indigo-50 transition-colors select-none">
                                            +
                                        </button>
                                    </div>
                                    <p class="mt-2 flex items-center gap-1.5 text-xs text-slate-400">
                                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-semibold text-indigo-700">
                                            1 – 26
                                        </span>
                                        Tối đa 26 hàng, ký hiệu A → Z.
                                    </p>
                                    <span asp-validation-for="TotalRows" class="mt-1 block text-xs text-red-600"></span>
                                </div>

                                @* Số cột *@
                                <div>
                                    <label asp-for="TotalCols" class="mb-1.5 block text-sm font-medium text-slate-800">
                                        Số cột ghế <span class="text-red-500">*</span>
                                    </label>
                                    <div class="flex overflow-hidden rounded-xl border border-slate-200 bg-slate-50
                                                focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-100
                                                transition">
                                        <button type="button" onclick="stepValue('TotalCols', -1)" aria-label="Giảm cột"
                                                class="flex w-11 flex-shrink-0 items-center justify-center
                                                       text-slate-500 text-lg hover:bg-slate-100 hover:text-indigo-600
                                                       active:bg-indigo-50 transition-colors select-none">
                                            −
                                        </button>
                                        <input asp-for="TotalCols" type="number" id="TotalCols"
                                               min="1" max="50" required
                                               value="@(Model?.TotalCols > 0 ? Model.TotalCols : 12)"
                                               class="flex-1 min-w-0 border-0 bg-transparent py-2.5 text-center
                                                      text-base font-semibold text-slate-900 outline-none
                                                      focus:ring-0" />
                                        <button type="button" onclick="stepValue('TotalCols', 1)" aria-label="Tăng cột"
                                                class="flex w-11 flex-shrink-0 items-center justify-center
                                                       text-slate-500 text-lg hover:bg-slate-100 hover:text-indigo-600
                                                       active:bg-indigo-50 transition-colors select-none">
                                            +
                                        </button>
                                    </div>
                                    <p class="mt-2 flex items-center gap-1.5 text-xs text-slate-400">
                                        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[10px] font-semibold text-indigo-700">
                                            1 – 50
                                        </span>
                                        Tối đa 50 cột để sơ đồ không vỡ layout.
                                    </p>
                                    <span asp-validation-for="TotalCols" class="mt-1 block text-xs text-red-600"></span>
                                </div>
                            </div>

                            @* Transaction Notice *@
                            <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4">
                                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-amber-600" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                </svg>
                                <div>
                                    <p class="mb-1 text-xs font-semibold text-amber-800">
                                        Thao tác này chạy một Database Transaction
                                    </p>
                                    <p class="text-xs text-amber-700">
                                        Khi nhấn <strong>Lưu phòng chiếu</strong>, hệ thống tự động sinh toàn bộ ghế
                                        ngồi trong cùng một transaction. Nếu có lỗi xảy ra, toàn bộ sẽ
                                        <strong>Rollback</strong> — không có dữ liệu rác.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Actions *@
                    <div class="flex flex-wrap items-center gap-3 pt-1">
                        <button type="submit" id="submitBtn"
                                class="inline-flex min-w-[190px] items-center justify-center gap-2 rounded-xl
                                       bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm
                                       hover:bg-indigo-700 hover:-translate-y-px hover:shadow-indigo-200/60 hover:shadow-lg
                                       active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-80
                                       transition-all focus-visible:outline-none focus-visible:ring-2
                                       focus-visible:ring-indigo-600 focus-visible:ring-offset-2">
                            <span id="btnText" class="flex items-center gap-2">
                                <!-- <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h4.5z"/>
                                </svg> -->
                                Tạo phòng chiếu
                            </span>
                            <span id="btnLoading" class="hidden items-center gap-2">
                                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
                                </svg>
                                Đang xử lý...
                            </span>
                        </button>

                        <a asp-action="Index"
                           class="inline-flex items-center rounded-xl border border-slate-300 bg-slate-10 px-5 py-3
                                  text-sm font-bold text-slate-600 hover:bg-slate-100 hover:border-slate-400
                                  transition-colors">
                            Hủy
                        </a>
                    </div>

                </div>

                @* ════ RIGHT: Live Preview ════════════════════════════════════ *@
                <div class="w-full lg:w-72 xl:w-80 lg:flex-shrink-0">
                    <div class="sticky top-6 rounded-2xl bg-slate-900 p-6 text-white"
                         aria-label="Preview sức chứa phòng chiếu">

                        <p class="mb-4 text-[10px] font-bold uppercase tracking-[.14em] text-white/40">
                            Live Preview · Sức chứa
                        </p>

                        @* Stats *@
                        <div class="space-y-0 divide-y divide-white/[.07]">
                            <div class="flex items-baseline justify-between py-2.5">
                                <span class="text-sm text-white/50">Số hàng</span>
                                <span id="prevRows" class="font-bold text-violet-300">10</span>
                            </div>
                            <div class="flex items-baseline justify-between py-2.5">
                                <span class="text-sm text-white/50">Số cột</span>
                                <span id="prevCols" class="font-bold text-violet-300">12</span>
                            </div>
                            <div class="flex items-baseline justify-between py-2.5">
                                <span class="text-sm text-white/50">Ký hiệu hàng</span>
                                <span id="prevRowLabel" class="text-sm font-bold tracking-wide text-white">A → J</span>
                            </div>
                            <div class="flex items-baseline justify-between py-2.5">
                                <span class="text-sm text-white/50">Ghế đầu / cuối</span>
                                <span id="prevRange" class="text-sm font-bold text-white">A1 → J12</span>
                            </div>
                        </div>

                        @* Total *@
                        <div class="mt-4 rounded-xl border border-indigo-500/40 bg-indigo-600/20 px-4 py-4 text-center">
                            <div id="prevTotal" class="text-4xl font-extrabold text-violet-300">120</div>
                            <div class="mt-1 text-xs text-white/40">ghế sẽ được tự động tạo</div>
                        </div>

                        @* Mini seat grid *@
                        <div id="seatViz" aria-hidden="true"
                             class="mt-5 flex flex-col items-center gap-[3px]"></div>

                        <p class="mt-4 text-center text-[10px] text-white/25">Cập nhật theo thời gian thực</p>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            const rowsInput = document.getElementById('TotalRows');
            const colsInput = document.getElementById('TotalCols');
            const submitBtn = document.getElementById('submitBtn');
            const btnText   = document.getElementById('btnText');
            const btnLoading= document.getElementById('btnLoading');
            const form      = document.getElementById('createRoomForm');
            const overlay   = document.getElementById('processingOverlay');
            const seatMsg   = document.getElementById('seatCountMsg');

            const ALPHA = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const MAX_VIZ_ROWS = 10;
            const MAX_VIZ_COLS = 18;

            /* ── STEPPER ──────────────────────────────────────── */
            window.stepValue = function (id, delta) {
                const el  = document.getElementById(id);
                const min = parseInt(el.min, 10);
                const max = parseInt(el.max, 10);
                const cur = parseInt(el.value, 10) || min;
                el.value  = Math.min(max, Math.max(min, cur + delta));
                el.dispatchEvent(new Event('input', { bubbles: true }));
            };

            /* ── LIVE PREVIEW ─────────────────────────────────── */
            function updatePreview() {
                const rows  = Math.min(26, Math.max(1, parseInt(rowsInput.value, 10) || 1));
                const cols  = Math.min(50, Math.max(1, parseInt(colsInput.value, 10) || 1));
                const total = rows * cols;

                document.getElementById('prevRows').textContent     = rows;
                document.getElementById('prevCols').textContent     = cols;
                document.getElementById('prevTotal').textContent    = total.toLocaleString('vi-VN');
                document.getElementById('prevRowLabel').textContent =
                    rows === 1 ? 'A' : `A → ${ALPHA[rows - 1]}`;
                document.getElementById('prevRange').textContent    =
                    `A1 → ${ALPHA[rows - 1]}${cols}`;
                if (seatMsg) seatMsg.textContent = total.toLocaleString('vi-VN');

                /* Mini seat grid */
                const vizR   = Math.min(rows, MAX_VIZ_ROWS);
                const vizC   = Math.min(cols, MAX_VIZ_COLS);
                const clipped = rows > MAX_VIZ_ROWS || cols > MAX_VIZ_COLS;
                let html = '';
                for (let r = 0; r < vizR; r++) {
                    html += '<div class="flex gap-[3px]">';
                    for (let c = 0; c < vizC; c++) {
                        const edge = clipped && (r === vizR - 1 || c === vizC - 1);
                        html += `<div class="h-[7px] w-[7px] rounded-sm transition-all ${
                            edge ? 'bg-amber-400/55' : 'bg-indigo-500/85'
                        }"></div>`;
                    }
                    html += '</div>';
                }
                if (clipped) {
                    const hidden = total - vizR * vizC;
                    html += `<p class="mt-2 text-center text-[10px] text-white/30">
                                +${hidden.toLocaleString('vi-VN')} ghế không hiển thị
                             </p>`;
                }
                document.getElementById('seatViz').innerHTML = html;
            }

            rowsInput.addEventListener('input', updatePreview);
            colsInput.addEventListener('input', updatePreview);
            updatePreview();

            /* ── CINEMA DROPDOWN ──────────────────────────────── */
            const cinemaInput   = document.getElementById('CinemaId');
            const cinemaPanel   = document.getElementById('cinemaPanel');
            const cinemaTrigger = document.getElementById('cinemaTrigger');
            const cinemaLabel   = document.getElementById('cinemaLabel');
            const cinemaChevron = document.getElementById('cinemaChevron');
            const cinemaError   = document.getElementById('cinemaError');

            window.toggleCinemaDropdown = function (evt) {
                evt.stopPropagation();
                const isOpen = !cinemaPanel.classList.contains('hidden');
                cinemaPanel.classList.toggle('hidden', isOpen);
                cinemaChevron.style.transform = isOpen ? '' : 'rotate(180deg)';
            };

            /* ── REAL-TIME VALIDATION — Room Name Uniqueness ── */
            let validationTimeout;
            const roomNameInput = document.getElementById('roomName');
            const roomNameFeedback = document.getElementById('roomNameFeedback');

            async function validateRoomNameSync() {
                const cinemaId = cinemaInput.value;
                const roomName = roomNameInput.value.trim();

                if (!cinemaId || !roomName) {
                    resetRoomNameValidation();
                    return;
                }

                try {
                    const response = await fetch(`@Url.Action("CheckRoomNameExists", "Rooms")?cinemaId=${cinemaId}&roomName=${encodeURIComponent(roomName)}`);
                    const data = await response.json();

                    if (data.exists) {
                        roomNameInput.classList.add('!border-red-400', '!ring-red-100', '!ring-2');
                        roomNameInput.classList.remove('!border-emerald-400', '!ring-emerald-100');
                        roomNameFeedback.textContent = 'Tên phòng chiếu này đã tồn tại trong rạp được chọn.';
                        roomNameFeedback.classList.remove('hidden');
                        submitBtn.disabled = true;
                    } else {
                        roomNameInput.classList.remove('!border-red-400', '!ring-red-100', '!ring-2');
                        roomNameInput.classList.add('!border-emerald-400', '!ring-emerald-100', '!ring-2');
                        roomNameFeedback.classList.add('hidden');
                        submitBtn.disabled = false;
                    }
                } catch (err) {
                    console.error('Validation error:', err);
                }
            }

            function resetRoomNameValidation() {
                roomNameInput.classList.remove('!border-red-400', '!ring-red-100', '!ring-2', '!border-emerald-400', '!ring-emerald-100');
                roomNameFeedback.classList.add('hidden');
                submitBtn.disabled = false;
            }

            roomNameInput.addEventListener('input', () => {
                clearTimeout(validationTimeout);
                validationTimeout = setTimeout(validateRoomNameSync, 500);
            });

            window.selectCinema = function (value, label, btn) {
                cinemaInput.value = value;
                cinemaLabel.textContent = label;
                cinemaLabel.className = 'flex-1 truncate text-left font-medium text-slate-900';
                cinemaTrigger.classList.remove('!border-red-400', '!ring-red-100', '!ring-2');
                cinemaTrigger.className = cinemaTrigger.className
                    .replace('border-slate-200 bg-slate-50', 'border-indigo-300 bg-white');
                cinemaError.classList.add('hidden');
                cinemaPanel.classList.add('hidden');
                cinemaChevron.style.transform = '';

                // Update options UI in panel
                cinemaPanel.querySelectorAll('.filter-tick').forEach(t => t.classList.add('hidden'));
                cinemaPanel.querySelectorAll('.filter-text').forEach(t => {
                    t.classList.remove('font-semibold', 'text-indigo-700');
                    t.classList.add('text-slate-600');
                });

                if (btn) {
                    const tick = btn.querySelector('.filter-tick');
                    const text = btn.querySelector('.filter-text');
                    if (tick) tick.classList.remove('hidden');
                    if (text) {
                        text.classList.add('font-semibold', 'text-indigo-700');
                        text.classList.remove('text-slate-600');
                    }
                }
                
                // Trigger re-validation when cinema changes
                validateRoomNameSync();
            };

            // Đóng dropdown khi click ngoài
            document.addEventListener('click', function (e) {
                if (!e.target.closest('#cinemaDropdownRoot')) {
                    cinemaPanel.classList.add('hidden');
                    cinemaChevron.style.transform = '';
                }
            });

            /* ── SUBMIT GUARD — chặn double-click ─────────────── */
            let submitted = false;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                /* 1. Validate cinema required thủ công */
                if (!cinemaInput.value) {
                    cinemaError.classList.remove('hidden');
                    cinemaTrigger.classList.add('!border-red-400', '!ring-red-100', '!ring-2');
                    cinemaInput.closest('.relative').scrollIntoView({ behavior: 'smooth', block: 'center' });
                    return;
                }
                /* 2. HTML5 validation */
                if (!form.checkValidity()) {
                    form.classList.add('was-validated');
                    return;
                }
                /* 3. Chặn submit lần hai */
                if (submitted) return;
                submitted = true;

                /* 4. UI States */
                submitBtn.disabled = true;
                submitBtn.setAttribute('aria-busy', 'true');
                btnText.classList.add('hidden');
                btnLoading.classList.remove('hidden');
                btnLoading.classList.add('flex');
                overlay.classList.remove('hidden');
                overlay.classList.add('flex');

                // Standard form submission
                form.submit();
            });

            /* 6. Xử lý user nhấn Back (bfcache) */
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) {
                    submitted = false;
                    submitBtn.disabled = false;
                    submitBtn.removeAttribute('aria-busy');
                    btnText.classList.remove('hidden');
                    btnLoading.classList.add('hidden');
                    btnLoading.classList.remove('flex');
                    overlay.classList.add('hidden');
                    overlay.classList.remove('flex');
                }
            });

        })();
    </script>
}

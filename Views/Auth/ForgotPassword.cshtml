@model CinemaManagement.ViewModels.Auth.ForgotPasswordViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu | PRIME NINE Cinema</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        /* --- CSS CƠ BẢN (Đồng bộ với trang Đăng Nhập) --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f7f9;
            color: #333;
        }

        .auth-section {
            padding: 60px 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: url('/asset/img/1702x621-2-174231-190126-68.jpg') no-repeat center center;
            background-size: cover;
        }

        .auth-card {
            width: 100%;
            max-width: 400px;
            background: rgba(255, 255, 255, 0.98);
            padding: 40px 30px;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            text-align: center;
        }

        .logo-small {
            width: min(100%, 240px);
            height: auto;
            display: block;
            margin: 0 auto 20px;
        }

        .auth-title {
            color: #0056b3;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .auth-desc {
            font-size: 14px;
            color: #666;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        /* --- FORM --- */
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: bold;
                font-size: 13px;
            }

            .form-group input {
                width: 100%;
                padding: 12px;
                border: 1px solid #ddd;
                border-radius: 6px;
                outline: none;
                transition: 0.3s;
            }

                .form-group input:focus {
                    border-color: #0056b3;
                    box-shadow: 0 0 5px rgba(0,86,179,0.2);
                }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: #0056b3;
            color: white;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            font-size: 15px;
            transition: 0.3s;
        }

            .btn-submit:hover {
                background: #004494;
            }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            color: #0056b3;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
        }

            .back-link:hover {
                text-decoration: underline;
            }

        /* --- THÔNG BÁO THÀNH CÔNG (ẨN MẶC ĐỊNH) --- */
        #success-msg {
            display: none;
            color: #28a745;
            background: #e9f7ef;
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .text-danger { color: #d9534f; margin-top:6px; display:block; }
    </style>
</head>
<body>

    <main class="auth-section">
        <div class="auth-card">
            <a href="@Url.Action("Index", "Home")">
                <img src="~/images/prime-nine-logo.png" alt="Prime Nine Cinema Logo" class="logo-small">
            </a>

            <h2 class="auth-title">Quên mật khẩu?</h2>
            <p class="auth-desc">Vui lòng nhập email đã đăng ký. Chúng tôi sẽ gửi mã xác nhận để khôi phục mật khẩu của bạn.</p>

            <div id="success-msg">Yêu cầu đã được gửi! Vui lòng kiểm tra hộp thư của bạn.</div>

            <form asp-action="ForgotPassword" method="post" id="forgot-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập email đã đăng ký" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Mã xác thực</label>
                    <div style="display:flex; gap:10px;">
                        <input type="text" id="captchaInput" placeholder="Nhập mã" required style="flex:1">
                        <div id="captchaBox" title="Click để làm mới" style="user-select:none; padding:10px; border-radius:6px; background:#f0f0f0; display:flex; align-items:center; justify-content:center; min-width:110px;"></div>
                    </div>
                    <!-- Inline captcha error (client-side) -->
                    <span id="captchaError" class="text-danger" style="display:none"></span>
                </div>

                <button type="submit" class="btn-submit">GỬI OTP</button>
            </form>

            <a href="@Url.Action("Login", "Auth")" class="switch-link">
                ← Quay lại đăng nhập
            </a>
          
        </div>
    </main>

    <script>
        // Captcha + inline validation (no alert)
        (function () {
            let currentCaptcha = "";

            function generateCaptcha() {
                currentCaptcha = Math.floor(100000 + Math.random() * 900000).toString();
                const box = document.getElementById("captchaBox");
                if (box) box.innerText = currentCaptcha;
            }

            const form = document.getElementById("forgot-form");
            const captchaInput = document.getElementById("captchaInput");
            const captchaBox = document.getElementById("captchaBox");
            const captchaError = document.getElementById("captchaError");
            const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

            if (captchaBox) {
                captchaBox.addEventListener("click", generateCaptcha);
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    // Clear previous error
                    if (captchaError) {
                        captchaError.style.display = 'none';
                        captchaError.innerText = '';
                    }

                    if (!captchaInput || !captchaBox) {
                        return;
                    }

                    const userCaptcha = captchaInput.value.trim();

                    // Let HTML5 required / unobtrusive validation handle empty field
                    if (userCaptcha === "") {
                        return;
                    }

                    if (userCaptcha !== currentCaptcha) {
                        // prevent submit and show inline message
                        e.preventDefault();
                        if (captchaError) {
                            captchaError.innerText = "Mã xác thực không đúng.";
                            captchaError.style.display = 'block';
                        }
                        generateCaptcha();
                        captchaInput.value = "";
                        captchaInput.focus();
                        return;
                    }

                    // Captcha OK → disable submit to prevent double submit and allow server validation for email
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerText = "Đang gửi...";
                    }
                    // do not call e.preventDefault() here — allow normal POST to controller
                });
            }

            // initialize captcha on load
            generateCaptcha();
        })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>     
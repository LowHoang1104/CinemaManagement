@model CinemaManagement.ViewModels.Auth.ResetPasswordViewModel
@{
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt lại mật khẩu | Beta Cinemas</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        /* --- CSS CƠ BẢN (Đồng bộ hệ thống) --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f7f9;
        }

        .auth-section {
            padding: 60px 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .auth-card {
            width: 100%;
            max-width: 400px;
            background: #fff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
            text-align: center;
        }

        .auth-title {
            color: #0056b3;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .auth-desc {
            font-size: 14px;
            color: #666;
            margin-bottom: 25px;
        }

        /* --- FORM --- */
        .form-group {
            margin-bottom: 16px;
            text-align: left;
            position: relative;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        .error-text {
            color: #d9534f;
            font-size: 12px;
            margin-top: 6px;
            display: block;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: #0056b3;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn-submit:hover {
            background: #004494;
        }

        .captcha-box {
            user-select: none;
            padding: 10px 14px;
            border-radius: 6px;
            background: #f0f0f0;
            border: 1px solid #ddd;
            font-weight: 700;
            letter-spacing: 4px;
        }
    </style>
</head>
<body>
    <main class="auth-section">
        <div class="auth-card">
            <h2>MẬT KHẨU MỚI</h2>
            <p style="color:#666;margin-bottom:18px;">Vui lòng thiết lập mật khẩu mới.</p>

            @Html.AntiForgeryToken()
            <form asp-action="ResetPassword" method="post" id="resetForm" novalidate>
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="error-text" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
                    @foreach (var m in ViewData.ModelState.Values)
                    {
                        foreach (var e in m.Errors)
                        {
                            @e.ErrorMessage <br />
                        }
                    }
                </div>

                <div class="form-group">
                    <label for="NewPassword">Mật khẩu mới</label>
                    <input asp-for="NewPassword" id="NewPassword" type="password" placeholder="tối thiểu 6 kí tự(chứa ít nhất 1 chữ và 1 số)" />
                    <span asp-validation-for="NewPassword" class="error-text"></span>
                </div>

                <div class="form-group">
                    <label for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" placeholder="nhập lại mật khẩu mới"/>
                    <span asp-validation-for="ConfirmPassword" class="error-text"></span>
                </div>

                <div class="form-group">
                    <label>Nhập mã xác thực</label>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <input id="captchaInput" name="CaptchaInput" type="text" maxlength="6" placeholder="Nhập 6 chữ số" style="flex:1;padding:10px;border:1px solid #ddd;border-radius:6px;" />
                        <div id="captchaBox" class="captcha-box" title="Click để làm mới"></div>
                    </div>
                    <span id="captchaError" class="error-text" style="display:none"></span>
                </div>

                <button type="submit" class="btn-submit">CẬP NHẬT MẬT KHẨU</button>
            </form>
        </div>
    </main>                                                 

    <script>
        (function () {
            // helper: generate 6-digit captcha string
            function genCaptcha() {
                return Math.floor(100000 + Math.random() * 900000).toString();
            }

            const captchaBox = document.getElementById('captchaBox');
            const captchaInput = document.getElementById('captchaInput');
            const captchaError = document.getElementById('captchaError');
            const newPassEl = document.getElementById('NewPassword');
            const confirmPassEl = document.getElementById('ConfirmPassword');
            const newPassErr = document.querySelector('[asp-validation-for="NewPassword"]') || document.querySelector('.error-text[for="NewPassword"]');
            const confirmPassErr = document.querySelector('[asp-validation-for="ConfirmPassword"]') || document.querySelector('.error-text[for="ConfirmPassword"]');

            // store current captcha
            let currentCaptcha = genCaptcha();
            if (captchaBox) captchaBox.textContent = currentCaptcha;

            // refresh captcha on click
            if (captchaBox) captchaBox.addEventListener('click', function () {
                currentCaptcha = genCaptcha();
                captchaBox.textContent = currentCaptcha;
                // clear previous error
                captchaError.style.display = 'none';
                captchaError.textContent = '';
            });

            // client-side password rule: at least 6 chars, at least 1 letter and 1 number
            const passRegex = /(?=.*[A-Za-z])(?=.*\d).{6,}/;

            // On submit validate captcha and password client-side; server-side DataAnnotations still apply
            document.getElementById('resetForm').addEventListener('submit', function (e) {
                // clear previous errors
                captchaError.style.display = 'none';
                captchaError.textContent = '';
                // clear input field inline errors left by previous client checks
                if (newPassEl) { newPassEl.classList.remove('invalid'); }
                if (confirmPassEl) { confirmPassEl.classList.remove('invalid'); }

                let hasErr = false;

                // validate password pattern client-side (same rule as server)
                const newPass = newPassEl ? newPassEl.value.trim() : '';
                const confirmPass = confirmPassEl ? confirmPassEl.value.trim() : '';
                if (!passRegex.test(newPass)) {
                    hasErr = true;
                    // display inline message using existing asp-validation-for span
                    const span = document.querySelector('span[data-valmsg-for="NewPassword"]') || document.querySelector('span[asp-validation-for="NewPassword"]');
                    if (span) {
                        span.textContent = 'Mật khẩu phải tối thiểu 6 ký tự và gồm chữ và số';
                        span.style.display = 'block';
                    }
                } else {
                    const span = document.querySelector('span[data-valmsg-for="NewPassword"]') || document.querySelector('span[asp-validation-for="NewPassword"]');
                    if (span) { span.textContent = ''; span.style.display = 'none'; }
                }

                if (newPass !== confirmPass) {
                    hasErr = true;
                    const span = document.querySelector('span[data-valmsg-for="ConfirmPassword"]') || document.querySelector('span[asp-validation-for="ConfirmPassword"]');
                    if (span) {
                        span.textContent = 'Mật khẩu xác nhận không khớp';
                        span.style.display = 'block';
                    }
                } else {
                    const span = document.querySelector('span[data-valmsg-for="ConfirmPassword"]') || document.querySelector('span[asp-validation-for="ConfirmPassword"]');
                    if (span) { span.textContent = ''; span.style.display = 'none'; }
                }

                // captcha validate
                const cInput = captchaInput ? captchaInput.value.trim() : '';
                if (cInput !== currentCaptcha) {
                    hasErr = true;
                    captchaError.style.display = 'block';
                    captchaError.textContent = 'Captcha không đúng';
                    // regenerate captcha so attacker can't brute-force quickly
                    currentCaptcha = genCaptcha();
                    captchaBox.textContent = currentCaptcha;
                    captchaInput.value = '';
                }

                if (hasErr) {
                    e.preventDefault();
                    return false;
                }

                // allow form submit -> server will validate DataAnnotations and reset password
                return true;
            });
        })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
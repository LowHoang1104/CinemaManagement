@model CinemaManagement.ViewModels.Auth.ProfileViewModel
@{
    ViewBag.Title = "Thông tin tài khoản";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang cá nhân | PRIME NINE Cinema</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background: #f3f6fb;
            color: #333;
        }

        .auth-section {
            padding: 42px 0 60px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            background: url('/asset/img/1702x621-2-174231-190126-68.jpg') no-repeat center center;
            background-size: cover;
        }

        .auth-card {
            width: 100%;
            max-width: 980px;
            background: rgba(255, 255, 255, 0.98);
            padding: 26px;
            border-radius: 16px;
            box-shadow: 0 16px 42px rgba(0, 0, 0, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .alert-success-inline {
            padding: 12px 14px;
            background: #ecfdf3;
            color: #065f46;
            border: 1px solid #b7f7d3;
            border-radius: 10px;
            margin-bottom: 14px;
            font-weight: 600;
        }

        .profile-title {
            margin-bottom: 16px;
            color: #1b2a41;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 0.2px;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 20px;
        }

        .profile-side {
            background: linear-gradient(160deg, #0d4f9d 0%, #1a69c7 100%);
            color: #fff;
            border-radius: 14px;
            padding: 18px;
            min-height: 100%;
        }

        .avatar-circle {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .profile-side h3 {
            font-size: 20px;
            margin-bottom: 4px;
        }

        .profile-side .meta {
            font-size: 13px;
            opacity: 0.95;
            margin-bottom: 6px;
        }

        .profile-side .badge-line {
            margin-top: 12px;
            display: inline-block;
            font-size: 12px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 6px 10px;
            border-radius: 999px;
            font-weight: 700;
            letter-spacing: 0.2px;
        }

        .form-area {
            padding-top: 0;
        }

        .form-panel {
            background: #fff;
            border: 1px solid #e9edf4;
            border-radius: 14px;
            padding: 18px;
            box-shadow: 0 10px 30px rgba(16, 24, 40, 0.06);
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            margin-bottom: 14px;
        }

            .form-group label {
                display: block;
                font-weight: 700;
                font-size: 13px;
                margin-bottom: 6px;
                color: #1b2a41;
            }

            .form-group input {
                width: 100%;
                padding: 11px 12px;
                border-radius: 8px;
                border: 1px solid #d6dce8;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }

            .form-group input:focus {
                outline: none;
                border-color: #0b5cb6;
                box-shadow: 0 0 0 3px rgba(11, 92, 182, 0.12);
            }

        .text-danger {
            color: #dc3545;
            font-size: 13px;
            margin-top: 6px;
            display: block;
        }

        .actions {
            margin-top: 14px;
            display: flex;
            justify-content: center;
        }

        .btn-save {
            width: 220px;
            padding: 12px 16px;
            background: linear-gradient(90deg, #0b5cb6 0%, #1f7ad8 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(11, 92, 182, 0.24);
        }

        .note-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-top: 22px;
            color: #0b5cb6;
            cursor: pointer;
            background: #eef5ff;
            border: 1px solid #d7e8ff;
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
        }

        .required {
            color: #d93737;
            margin-right: 4px;
        }

        .cp-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.56);
            z-index: 1200;
            align-items: center;
            justify-content: center;
        }

        .cp-modal {
            width: 520px;
            max-width: 94%;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.26);
            padding: 18px;
            position: relative;
        }

        .cp-close {
            position: absolute;
            right: 12px;
            top: 12px;
            border: 0;
            background: transparent;
            font-size: 18px;
            cursor: pointer;
            color: #667085;
        }

        .cp-title {
            margin: 0 0 14px;
            font-weight: 700;
            color: #1b2a41;
        }

        .cp-stack {
            display: grid;
            gap: 12px;
        }

        .cp-label {
            display: block;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .cp-input {
            width: 100%;
            padding: 10px;
            border: 1px solid #d7dbe4;
            border-radius: 8px;
        }

        .cp-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 6px;
        }

        .cp-btn-cancel {
            padding: 10px 14px;
            border-radius: 8px;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            cursor: pointer;
        }

        .cp-btn-submit {
            padding: 10px 16px;
            border-radius: 8px;
            background: #0b5cb6;
            color: #fff;
            border: 0;
            cursor: pointer;
            font-weight: 700;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 900px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }

            .two-col {
                grid-template-columns: 1fr;
            }

            .auth-card {
                padding: 20px;
            }

            .note-link {
                width: 100%;
                margin-top: 6px;
            }
        }
    </style>

</head>
<body>
    <main class="auth-section" role="main">
        <div class="auth-card">
            @if (TempData["ProfileUpdateSuccess"] != null)
            {
                <div class="alert-success-inline">
                    @TempData["ProfileUpdateSuccess"]
                </div>
            }

            <div class="profile-title">THÔNG TIN TÀI KHOẢN</div>

            <div class="profile-grid">
                <aside class="profile-side">
                    <div class="avatar-circle">@((!string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Trim()[0] : 'U').ToString().ToUpper())</div>
                    <h3>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Người dùng" : Model.FullName)</h3>
                    <div class="meta">@Model.Email</div>
                    <div class="meta">@Model.PhoneNumber</div>
                    <span class="badge-line">THÀNH VIÊN PRIME NINE</span>
                </aside>

                <div class="form-area">
                    <div class="form-panel">
                        <form asp-action="Profile" asp-controller="Auth" method="post" id="profileForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="UserId" />

                            <div class="two-col">
                                <div>
                                    <div class="form-group">
                                        <label asp-for="FullName"><span class="required">*</span>Họ và tên</label>
                                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="PhoneNumber"><span class="required">*</span>Điện thoại</label>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="0*********" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                    </div>
                                </div>

                                <div>
                                    <div class="form-group">
                                        <label asp-for="Email"><span class="required">*</span>Email</label>
                                        <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <button type="button" id="btnOpenChangePassword" class="note-link">Đổi mật khẩu?</button>
                                </div>
                            </div>

                            <div class="actions">
                                <button type="submit" class="btn-save">CẬP NHẬT</button>
                            </div>
                        </form>
                    </div>

                    <!-- MOVE modal OUTSIDE the profile <form> (important) -->
                    <div id="cpOverlay" class="cp-overlay">
                        <div id="cpModal" class="cp-modal">
                            <button id="cpClose" class="cp-close" type="button">✕</button>
                            <h3 class="cp-title">ĐỔI MẬT KHẨU</h3>

                            <form id="changePasswordForm" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <div class="cp-stack">
                                    <div>
                                        <label class="cp-label">Mật khẩu hiện tại <span class="required">*</span></label>
                                        <input name="CurrentPassword" class="cp-input" type="password" placeholder="Nhập mật khẩu hiện tại" />
                                        <div class="cp-error text-danger" data-for="CurrentPassword" style="margin-top:6px;"></div>
                                    </div>

                                    <div>
                                        <label class="cp-label">Mật khẩu mới <span class="required">*</span></label>
                                        <input name="NewPassword" class="cp-input" type="password" placeholder="Nhập mật khẩu mới" />
                                        <div class="cp-error text-danger" data-for="NewPassword" style="margin-top:6px;"></div>
                                    </div>

                                    <div>
                                        <label class="cp-label">Xác nhận mật khẩu mới <span class="required">*</span></label>
                                        <input name="ConfirmPassword" class="cp-input" type="password" placeholder="Nhập xác nhận mật khẩu mới" />
                                        <div class="cp-error text-danger" data-for="ConfirmPassword" style="margin-top:6px;"></div>
                                    </div>

                                    <div class="cp-actions">
                                        <button id="cpCancel" class="cp-btn-cancel" type="button">Hủy</button>
                                        <button id="cpSubmit" class="cp-btn-submit" type="submit">CẬP NHẬT</button>
                                    </div>

                                    <div id="cpGlobalMsg" style="margin-top:6px;"></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            const $overlay = $('#cpOverlay');
            const $openBtn = $('#btnOpenChangePassword');
            const $closeBtn = $('#cpClose');
            const $cancelBtn = $('#cpCancel');
            const $form = $('#changePasswordForm');
            const $submit = $('#cpSubmit');
            const $global = $('#cpGlobalMsg');

            function openModal() {
                // clear fields/errors
                $form[0].reset();
                $('.cp-error').text('');
                $global.html('');
                $overlay.css('display', 'flex');
                $('body').css('overflow', 'hidden');
            }
            function closeModal() {
                $overlay.hide();
                $('body').css('overflow', '');
            }

            $openBtn.on('click', function (e) {
                e.preventDefault();
                openModal();
            });
            $closeBtn.on('click', closeModal);
            $cancelBtn.on('click', closeModal);
            $overlay.on('click', function (e) {
                if (e.target === this) closeModal();
            });

            $form.on('submit', function (e) {
                e.preventDefault();
                $('.cp-error').text('');
                $global.html('');

                const data = $form.serializeArray().reduce(function (o, kv) { o[kv.name] = kv.value; return o; }, {});
                // client-side quick checks
                if (!data.CurrentPassword) { $('[data-for="CurrentPassword"]').text('Vui lòng nhập mật khẩu hiện tại'); return; }
                if (!data.NewPassword) { $('[data-for="NewPassword"]').text('Vui lòng nhập mật khẩu mới'); return; }
                if (data.NewPassword.length < 6) { $('[data-for="NewPassword"]').text('Mật khẩu phải từ 6 ký tự trở lên'); return; }
                if (!(/\d/.test(data.NewPassword) && /[A-Za-z]/.test(data.NewPassword))) {
                    $('[data-for="NewPassword"]').text('Mật khẩu phải chứa ít nhất 1 chữ cái và 1 chữ số'); return;
                }
                if (data.NewPassword !== data.ConfirmPassword) { $('[data-for="ConfirmPassword"]').text('Xác nhận mật khẩu không trùng'); return; }

                $submit.prop('disabled', true).text('Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("ChangePassword", "Auth")',
                    method: 'POST',
                    data: $form.serialize(),
                    success: function (res) {
                        if (res && res.success) {
                            $global.html('<div style="color: #065f46; background:#ecfdf5; padding:8px; border-radius:4px;">' + (res.message || 'Cập nhật thành công') + '</div>');
                            setTimeout(function () { closeModal(); location.reload(); }, 900);
                        } else {
                            $global.html('<div style="color:#b91c1c;">' + (res.error || 'Có lỗi xảy ra') + '</div>');
                            $submit.prop('disabled', false).text('CẬP NHẬT');
                        }
                    },
                    error: function () {
                        $global.html('<div style="color:#b91c1c;">Lỗi máy chủ. Vui lòng thử lại.</div>');
                        $submit.prop('disabled', false).text('CẬP NHẬT');
                    }
                });
            });
        })();
    </script>
</body>
</html>
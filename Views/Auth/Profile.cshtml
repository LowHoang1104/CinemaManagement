@model CinemaManagement.ViewModels.Auth.ProfileViewModel
@{
    ViewBag.Title = "Thông tin tài khoản";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang cá nhân | Beta Cinemas</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
        /* Reuse Register look so body aligns with shared _Layout header/footer */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f4f7f9;
            color: #333;
        }

        .auth-section {
            padding: 60px 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: url('https://betacinemas.vn/Assets/Common/img/bg-login.jpg') no-repeat center center;
            background-size: cover;
        }

        .auth-card {
            width: 100%;
            max-width: 780px;
            background: rgba(255, 255, 255, 0.98);
            padding: 28px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

        .tabs {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
        }

        .tab {
            padding: 8px 12px;
            font-weight: 700;
            color: #0b5cb6;
            background: #fff;
            border-radius: 6px;
        }

            .tab.active {
                background: #0b5cb6;
                color: #fff;
            }

        .profile-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 20px;
            align-items: start;
        }

        .avatar-card {
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: center;
            padding-top: 6px;
        }

        .avatar-preview {
            width: 140px;
            height: 140px;
            border-radius: 6px;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid #e6e6e6;
        }

        .form-area {
            padding-top: 6px;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            margin-bottom: 14px;
        }

            .form-group label {
                display: block;
                font-weight: 700;
                font-size: 13px;
                margin-bottom: 6px;
            }

            .form-group input {
                width: 100%;
                padding: 10px 12px;
                border-radius: 6px;
                border: 1px solid #ddd;
            }

        .text-danger {
            color: #dc3545;
            font-size: 13px;
            margin-top: 6px;
            display: block;
        }

        .actions {
            margin-top: 12px;
            display: flex;
            justify-content: center;
        }

        .btn-save {
            width: 220px;
            padding: 12px 16px;
            background: #28a745;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
        }

        .note-link {
            display: inline-block;
            margin-top: 10px;
            color: #0b5cb6;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
            font: inherit;
        }

        /* keep animations / media with @@ to avoid Razor parsing issues */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 900px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }

            .two-col {
                grid-template-columns: 1fr;
            }

            .avatar-preview {
                width: 84px;
                height: 84px;
            }

            .auth-card {
                padding: 20px;
            }
        }
    </style>

</head>
<body>
<main class="auth-section" role="main">
    <div class="auth-card">
        @if (TempData["ProfileUpdateSuccess"] != null)
        {
            <div style="padding:10px 14px; background:#e6ffed; color:#064e3b; border-radius:6px; margin-bottom:12px;">
                @TempData["ProfileUpdateSuccess"]
            </div>
        }

        <div class="tabs" style="margin-bottom:18px;">
            <div class="tab active">THÔNG TIN TÀI KHOẢN</div>
            <div class="tab">THẺ THÀNH VIÊN</div>
            <div class="tab">ĐƠN HÀNG CỦA TÔI</div>
            <div class="tab">ĐIỂM BETA</div>
            <div class="tab">CHỨNG TỪ</div>
        </div>

        <div class="profile-grid">
            <div class="avatar-card" aria-hidden="true">
                <div class="avatar-preview">
                    <div style="color:#94a3b8; font-size:14px;">No avatar</div>
                </div>
            </div>

            <div class="form-area">
                <form asp-action="Profile" asp-controller="Auth" method="post" id="profileForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <div class="two-col">
                        <div>
                            <div class="form-group">
                                <label asp-for="FullName"><span class="required">*</span>Họ và tên</label>
                                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="PhoneNumber"><span class="required">*</span>Điện thoại</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="0*********" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div>
                            <div class="form-group">
                                <label asp-for="Email"><span class="required">*</span>Email</label>
                                <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <!-- Replaced anchor with button (non-submit) so it won't submit profile form -->
                            <button type="button" id="btnOpenChangePassword" class="note-link">Đổi mật khẩu?</button>
                        </div>
                    </div>

                    <div class="actions">
                        <button type="submit" class="btn-save">CẬP NHẬT</button>
                    </div>
                </form>

                <!-- MOVE modal OUTSIDE the profile <form> (important) -->
                <div id="cpOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1200; align-items:center; justify-content:center;">
                    <div id="cpModal" style="width:520px; max-width:94%; background:#fff; border-radius:6px; box-shadow:0 10px 30px rgba(0,0,0,0.3); padding:18px; position:relative;">
                        <button id="cpClose" type="button" style="position:absolute; right:12px; top:12px; border:0; background:transparent; font-size:18px; cursor:pointer;">✕</button>
                        <h3 style="margin:0 0 14px 0; font-weight:700;">ĐỔI MẬT KHẨU</h3>

                        <form id="changePasswordForm" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div style="display:grid; gap:12px;">
                                <div>
                                    <label style="font-weight:700;">Mật khẩu hiện tại <span style="color:#d33">*</span></label>
                                    <input name="CurrentPassword" type="password" placeholder="Nhập mật khẩu hiện tại" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:4px;" />
                                    <div class="cp-error text-danger" data-for="CurrentPassword" style="margin-top:6px;"></div>
                                </div>

                                <div>
                                    <label style="font-weight:700;">Mật khẩu mới <span style="color:#d33">*</span></label>
                                    <input name="NewPassword" type="password" placeholder="Nhập mật khẩu mới" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:4px;" />
                                    <div class="cp-error text-danger" data-for="NewPassword" style="margin-top:6px;"></div>
                                </div>

                                <div>
                                    <label style="font-weight:700;">Xác nhận mật khẩu mới <span style="color:#d33">*</span></label>
                                    <input name="ConfirmPassword" type="password" placeholder="Nhập xác nhận mật khẩu mới" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:4px;" />
                                    <div class="cp-error text-danger" data-for="ConfirmPassword" style="margin-top:6px;"></div>
                                </div>

                                <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:6px;">
                                    <button id="cpCancel" type="button" style="padding:10px 14px; border-radius:6px; background:#f3f4f6; border:1px solid #e5e7eb; cursor:pointer;">Hủy</button>
                                    <button id="cpSubmit" type="submit" style="padding:10px 16px; border-radius:6px; background:#0b5cb6; color:#fff; border:0; cursor:pointer;">CẬP NHẬT</button>
                                </div>

                                <div id="cpGlobalMsg" style="margin-top:6px;"></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            const $overlay = $('#cpOverlay');
            const $openBtn = $('#btnOpenChangePassword');
            const $closeBtn = $('#cpClose');
            const $cancelBtn = $('#cpCancel');
            const $form = $('#changePasswordForm');
            const $submit = $('#cpSubmit');
            const $global = $('#cpGlobalMsg');

            function openModal() {
                // clear fields/errors
                $form[0].reset();
                $('.cp-error').text('');
                $global.html('');
                $overlay.css('display', 'flex');
                $('body').css('overflow', 'hidden');
            }
            function closeModal() {
                $overlay.hide();
                $('body').css('overflow', '');
            }

            $openBtn.on('click', function (e) {
                e.preventDefault();
                openModal();
            });
            $closeBtn.on('click', closeModal);
            $cancelBtn.on('click', closeModal);
            $overlay.on('click', function (e) {
                if (e.target === this) closeModal();
            });

            $form.on('submit', function (e) {
                e.preventDefault();
                $('.cp-error').text('');
                $global.html('');

                const data = $form.serializeArray().reduce(function (o, kv) { o[kv.name] = kv.value; return o; }, {});
                // client-side quick checks
                if (!data.CurrentPassword) { $('[data-for="CurrentPassword"]').text('Vui lòng nhập mật khẩu hiện tại'); return; }
                if (!data.NewPassword) { $('[data-for="NewPassword"]').text('Vui lòng nhập mật khẩu mới'); return; }
                if (data.NewPassword.length < 6) { $('[data-for="NewPassword"]').text('Mật khẩu phải từ 6 ký tự trở lên'); return; }
                if (!(/\d/.test(data.NewPassword) && /[A-Za-z]/.test(data.NewPassword))) {
                    $('[data-for="NewPassword"]').text('Mật khẩu phải chứa ít nhất 1 chữ cái và 1 chữ số'); return;
                }
                if (data.NewPassword !== data.ConfirmPassword) { $('[data-for="ConfirmPassword"]').text('Xác nhận mật khẩu không trùng'); return; }

                $submit.prop('disabled', true).text('Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("ChangePassword", "Auth")',
                    method: 'POST',
                    data: $form.serialize(),
                    success: function (res) {
                        if (res && res.success) {
                            $global.html('<div style="color: #065f46; background:#ecfdf5; padding:8px; border-radius:4px;">' + (res.message || 'Cập nhật thành công') + '</div>');
                            setTimeout(function () { closeModal(); location.reload(); }, 900);
                        } else {
                            $global.html('<div style="color:#b91c1c;">' + (res.error || 'Có lỗi xảy ra') + '</div>');
                            $submit.prop('disabled', false).text('CẬP NHẬT');
                        }
                    },
                    error: function () {
                        $global.html('<div style="color:#b91c1c;">Lỗi máy chủ. Vui lòng thử lại.</div>');
                        $submit.prop('disabled', false).text('CẬP NHẬT');
                    }
                });
            });
        })();
    </script>
</body>
</html>
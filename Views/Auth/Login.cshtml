@model CinemaManagement.ViewModels.Auth.LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    var resetMsg = TempData["ResetSuccess"] as string ?? ViewData["ResetSuccess"] as string;
    var pageReturnUrl = Model.ReturnUrl
        ?? ViewContext.HttpContext.Request.Query["returnUrl"].ToString()
        ?? ViewContext.HttpContext.Request.Query["ReturnUrl"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập | PRIME NINE Cinema</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Roboto', sans-serif; background-color: #f4f7f9; color: #333; }
        .auth-section { padding: 60px 0; min-height: 100vh; display: flex; justify-content: center; align-items: center; background: url('/asset/img/1702x621-2-174231-190126-68.jpg') no-repeat center center; background-size: cover; }
        .auth-card { width: 100%; max-width: 450px; background: rgba(255,255,255,0.98); padding: 40px 30px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
        .auth-toggle { width: 100%; height: 50px; background: #e9ecef; border-radius: 30px; display: flex; position: relative; margin-bottom: 20px; padding: 5px; }
        .toggle-btn { flex: 1; border: none; background: transparent; font-weight: bold; font-size: 14px; cursor: pointer; z-index: 2; color: #666; }
        .toggle-btn.active { color: #fff; }
        .toggle-slider { position: absolute; width: calc(50% - 5px); height: calc(100% - 10px); background: #0056b3; border-radius: 25px; top: 5px; left: 5px; transition: transform 0.4s ease; z-index: 1; }

        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; margin-bottom: 6px; font-weight: bold; font-size: 13px; }
        .form-group input { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 6px; outline: none; transition: border 0.3s; }
        .form-group input:focus { border-color: #0056b3; }

        .btn-submit { width: 100%; padding: 14px; background: #0056b3; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px; margin-top: 10px; }

        .forgot-pass { display: block; text-align: right; margin-top: 10px; color: #0056b3; text-decoration: none; font-size: 13px; }

        /* Captcha styling same as ForgotPassword */
        .captcha-row { display:flex; gap:10px; align-items:center; }
        .captcha-box { user-select:none; padding:10px; border-radius:6px; background:#f0f0f0; display:flex; align-items:center; justify-content:center; min-width:110px; font-weight:700; letter-spacing:4px; cursor:pointer; border:1px solid #ddd; }
        .captcha-input { flex:1; padding:10px; border:1px solid #ddd; border-radius:6px; }

        /* Remember row: checkbox and label on same line */
        .remember-row { display:flex; align-items:center; gap:8px; margin-top:8px; }
        .remember-row input[type="checkbox"] { width:16px; height:16px; margin:0; }
        .remember-row label { margin:0; font-weight:normal; font-size:14px; color:#333; }

        .text-danger { color:#d9534f; display:block; margin-top:6px; }

        .alert-success-inline { background-color:#d4edda; border:1px solid #c3e6cb; color:#155724; padding:10px; border-radius:6px; margin-bottom:12px; }

        /* Google button: red with icon */
        .btn-google {
            display:flex;
            align-items:center;
            gap:12px;
            justify-content:center;
            background:#DB4437; /* Google red */
            color:#fff;
            padding:10px 14px;
            border-radius:6px;
            text-decoration:none;
            font-weight:700;
            border:none;
            width:100%;
            box-sizing:border-box;
            cursor:pointer;
        }
        .btn-google svg { width:20px; height:20px; display:block; flex-shrink:0; }
        .btn-google:focus { outline:2px solid rgba(0,0,0,0.08); }
    </style>
</head>
<body>
    <main class="auth-section">
        <div class="auth-card"> 
            <div class="auth-toggle">
                <div class="toggle-slider" style="transform: translateX(0);"></div>
                <button class="toggle-btn active" type="button">ĐĂNG NHẬP</button>
                <button class="toggle-btn" type="button" onclick="window.location.href='@Url.Action("Register", "Auth")'">ĐĂNG KÝ</button>
            </div>

            <div id="login-form" class="form-content active">
                @if (TempData["RegisterSuccess"] != null)
                {
                    <div class="alert-success-inline">@TempData["RegisterSuccess"]</div>
                }

                @if (TempData["LoginError"] != null)
                {
                    <div class="alert" style="background-color: #f8d7da; color: #721c24; border-color: #f5c6cb; padding:10px; border-radius:6px; margin-bottom:12px;">
                        @TempData["LoginError"]
                    </div>
                }

                @if (!string.IsNullOrEmpty(resetMsg))
                {
                    <div class="alert-success-inline">@resetMsg</div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post" id="loginForm" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Hidden returnUrl field -->
                    <input type="hidden" name="ReturnUrl" value="@pageReturnUrl" />

                    <div class="form-group">
                        <label asp-for="Credential"></label>
                        <input asp-for="Credential" class="form-control" placeholder="Email hoặc Số điện thoại" autofocus />
                        <span asp-validation-for="Credential" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="********" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Mã xác thực</label>
                        <div class="captcha-row">
                            <div id="captchaBox" class="captcha-box" title="Click để làm mới"></div>
                            <input id="captchaInput" class="captcha-input" type="text" maxlength="6" placeholder="-> vui lòng nhập mã xác thực" required/>
                        </div>
                        <span id="captchaError" class="text-danger" style="display:none"></span>
                    </div>                 

                    <button type="submit" class="btn-submit">ĐĂNG NHẬP</button>

                    <a href="@Url.Action("ForgotPassword", "Auth")" class="forgot-pass">Quên mật khẩu?</a>
                </form>

                <div class="social-login" style="margin-top:20px;">
                    <p style="font-size: 13px; color: #888; margin-bottom: 12px; text-align:center;">Hoặc đăng nhập bằng</p>

                  
                    <a asp-controller="Auth" asp-action="GoogleLogin" asp-route-returnUrl="@pageReturnUrl" class="btn-google" title="Đăng nhập bằng Google">                      
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                            <path fill="#FFFFFF" d="M21.35 11.1h-9.2v2.8h5.3c-.2 1.6-1.4 4.3-5.3 4.3-3.2 0-5.8-2.6-5.8-5.8s2.6-5.8 5.8-5.8c1.8 0 3 0.8 3.7 1.5l2-1.9C17.2 4.1 15.1 3 12 3 7 3 3 7 3 12s4 9 9 9c5.2 0 8.6-3.6 8.6-8.7 0-.6-.1-1-.2-1.3z"/>
                        </svg>
                        <span>Đăng nhập với Google</span>
                    </a>
                </div>

                <a href="@Url.Action("Register", "Auth")" class="switch-link" style="display:block; text-align:center; margin-top:18px;">Chưa có tài khoản? Đăng ký ngay →</a>
            </div>
        </div>
    </main>

    <script>
        (function () {
                // Use the same captcha logic as ForgotPassword page
            let currentCaptcha = "";

            function generateCaptcha() {
                currentCaptcha = Math.floor(100000 + Math.random() * 900000).toString();
                const box = document.getElementById("captchaBox");
                if (box) box.innerText = currentCaptcha;
            }

            const form = document.getElementById("loginForm");
            const captchaInput = document.getElementById("captchaInput");
            const captchaBox = document.getElementById("captchaBox");
            const captchaError = document.getElementById("captchaError");
            const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

            if (captchaBox) {
                captchaBox.addEventListener("click", generateCaptcha);
            }

            if (form) {
                form.addEventListener("submit", function (e) {
                    // clear previous
                    if (captchaError) { captchaError.style.display = 'none'; captchaError.innerText = ''; }

                    if (!captchaInput || !captchaBox) return;

                    const userCaptcha = captchaInput.value.trim();

                    // Let HTML5 required show message if empty
                    if (userCaptcha === "") return;

                    if (userCaptcha !== currentCaptcha) {
                        e.preventDefault();
                        if (captchaError) {
                            captchaError.innerText = "Mã xác thực không đúng.";
                            captchaError.style.display = 'block';
                        }
                        generateCaptcha();
                        captchaInput.value = "";
                        captchaInput.focus();
                        return;
                    }

                    // captcha OK -> disable button to prevent double submit
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerText = "Đang gửi...";
                    }
                });
            }

            // init
            generateCaptcha();
        })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
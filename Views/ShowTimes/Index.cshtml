<!-- Conflict Resolution Modal -->
<div id="ConflictModal" class="fixed inset-0 z-[110] hidden opacity-0 transition-opacity duration-300 pointer-events-none" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-[2px] transition-opacity pointer-events-auto" aria-hidden="true" onclick="toggleConflictModal(false)"></div>
    <div class="fixed inset-0 overflow-y-auto pointer-events-none">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div id="ConflictModalContent" class="relative w-full max-w-xl transform overflow-hidden rounded-[2rem] bg-white text-left align-middle shadow-2xl transition-all translate-y-0 duration-300 pointer-events-auto flex flex-col max-h-[90vh]">
                <!-- Header -->
                <div class="px-8 py-6 border-b border-gray-100 bg-white flex items-start gap-4 flex-shrink-0">
                    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                        <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-slate-900 mt-1">Phát hiện xung đột thời gian chiếu</h2>
                        <p class="text-base text-slate-600 mt-2" id="ConflictSubtitle">Suất chiếu bạn muốn tạo bị trùng thời gian với {0} suất chiếu đã tồn tại trong {1}.</p>
                    </div>
                    <button onclick="toggleConflictModal(false)" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <!-- Body (Scrollable) -->
                <div class="px-8 py-6 overflow-y-auto custom-scrollbar flex-1 space-y-6">
                    <!-- New Show Preview -->
                    <div class="rounded-2xl border border-blue-200 bg-blue-50/50 p-4 hidden" id="ConflictNewShowBlock">
                        <div class="flex items-center gap-2 text-blue-700 font-semibold mb-3">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/></svg>
                            Suất chiếu muốn tạo:
                        </div>
                        <h3 class="text-lg font-bold text-blue-900" id="ConflictNewMovieName">Tên phim</h3>
                        <div class="text-blue-800 flex items-center gap-2 mt-2 font-medium">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span id="ConflictNewTime">12:00 - 15:00</span>
                        </div>
                        <div class="text-blue-700 mt-1 ml-6 text-sm" id="ConflictNewDate">Ngày</div>
                    </div>
                    <!-- Conflicting Shows List -->
                    <div class="rounded-2xl border border-red-100 bg-red-50/30 p-4">
                        <div class="flex items-center gap-2 text-red-700 font-semibold mb-4">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            Suất chiếu bị trùng:
                        </div>
                        <div class="space-y-3" id="ConflictList">
                            <!-- Dynamic blocks go here -->
                        </div>
                    </div>
                    <!-- Business Rules -->
                    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">
                        <div class="flex items-center gap-2 text-amber-800 font-bold mb-3">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            Quy tắc nghiệp vụ:
                        </div>
                        <ul class="list-disc list-inside text-amber-700 space-y-2 text-sm ml-2">
                            <li>Một phòng chiếu không thể chiếu 2 phim cùng lúc</li>
                            <li>Thời gian chiếu = Thời lượng phim + 15 phút dọn dẹp</li>
                            <li>Khoảng thời gian [Bắt đầu, Kết thúc] không được đè lên suất chiếu đã tồn tại</li>
                        </ul>
                        <div class="mt-4 pt-4 border-t border-amber-200/50 text-amber-800 text-sm font-medium">
                            <span class="font-bold">Đề xuất:</span> Chọn thời gian khác hoặc phòng chiếu khác để tránh xung đột.
                        </div>
                    </div>
                </div>
                <!-- Footer -->
                <div class="px-8 py-4 border-t border-gray-100 bg-gray-10 flex justify-end gap-3 rounded-b-[2rem] flex-shrink-0">
                    <button type="button" onclick="toggleConflictModal(false)" class="px-8 py-3 bg-slate-50 border border-slate-200 text-slate-700 font-bold rounded-xl hover:bg-slate-100 transition-all text-sm shadow-sm active:scale-95">
                        Đóng lại (Chọn giờ khác)
                    </button>
                    <!-- Overwrite button completely removed per rule strictness -->
                </div>
            </div>
        </div>
    </div>
</div>

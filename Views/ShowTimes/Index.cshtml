@model CinemaManagement.ViewModels.ShowTimeListViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Http.Extensions



@{
    ViewData["Title"] = "Quản lý suất chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<script src="https://cdn.tailwindcss.com"></script>


<div class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-slate-900">Quản lý suất chiếu</h1>
            <p class="text-slate-500 mt-1">Quản lý lịch chiếu phim với kiểm tra xung đột thời gian tự động</p>
        </div>
        <button id="OpenModalBtn" class="bg-slate-900 text-white px-6 py-2.5 rounded-xl flex items-center gap-2 hover:bg-slate-800 transition-all font-bold shadow-lg active:scale-[0.98]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Tạo suất chiếu
        </button>
    </div>

    <!-- Summary Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <!-- Upcoming -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 transition-all hover:shadow-md">
            <div class="flex items-center gap-3 mb-3">
                <div class="p-2 bg-blue-50 rounded-lg text-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-slate-500 font-bold text-sm uppercase tracking-wider">Sắp chiếu</span>
            </div>
            <div class="text-4xl font-extrabold text-slate-900">@Model.UpcomingCount</div>
        </div>

        <!-- Active -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 transition-all hover:shadow-md">
            <div class="flex items-center gap-3 mb-3">
                <div class="p-2 bg-green-50 rounded-lg text-green-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-slate-500 font-bold text-sm uppercase tracking-wider">Đang chiếu</span>
            </div>
            <div class="text-4xl font-extrabold text-slate-900">@Model.NowShowingCount</div>
        </div>

        <!-- Cancelled -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 transition-all hover:shadow-md">
            <div class="flex items-center gap-3 mb-3">
                <div class="p-2 bg-red-50 rounded-lg text-red-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-slate-500 font-bold text-sm uppercase tracking-wider">Đã hủy</span>
            </div>
            <div class="text-4xl font-extrabold text-slate-900">@Model.CancelledCount</div>
        </div>

        <!-- Today -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 transition-all hover:shadow-md">
            <div class="flex items-center gap-3 mb-3">
                <div class="p-2 bg-purple-50 rounded-lg text-purple-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <span class="text-slate-500 font-bold text-sm uppercase tracking-wider">Hôm nay</span>
            </div>
            <div class="text-4xl font-extrabold text-slate-900">@Model.TodayCount</div>
        </div>
    </div>

    <!-- Filter Bar -->
    <form id="filterForm" method="get" action="/ShowTimes/Index" class="bg-white border border-slate-200 rounded-2xl p-4 mb-6 flex flex-wrap gap-3 items-center">
        <!-- Search -->
        <div class="relative flex-1 min-w-[200px]">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text" name="search" value="@Model.SearchTerm"
                   placeholder="Tìm kiếm theo tên phim, rạp..."
                   class="w-full pl-9 pr-4 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all" />
        </div>

        <!-- Date -->
        <div class="relative">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <input type="date" name="date"
                   value="@(Model.DateFilter?.ToString("yyyy-MM-dd") ?? "")"
                   class="pl-9 pr-3 py-2.5 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all" />
        </div>

        <!-- Filter Action Wrapper -->
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center flex-wrap">
            <!-- Cinema custom dropdown -->
            @{
                var cinemaCurrent = Model.CinemaIdFilter.HasValue
                    ? (((IEnumerable<SelectListItem>)ViewBag.Cinemas).FirstOrDefault(c => c.Value == Model.CinemaIdFilter.ToString())?.Text ?? "Tất cả rạp")
                    : "Tất cả rạp";
            }
            <input type="hidden" name="cinemaId" id="cinemaIdInput" value="@(Model.CinemaIdFilter?.ToString() ?? "")" />
            <div class="relative sm:w-48" data-filter-dropdown>
                <button type="button" id="cinemaTrigger"
                        onclick="toggleFilterDropdown('cinemaPanel', event)"
                        class="flex w-full items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm hover:border-indigo-300 hover:bg-slate-50 transition-colors">
                    <svg class="h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
                    </svg>
                    <span id="cinemaLabel" class="flex-1 truncate text-left @(Model.CinemaIdFilter.HasValue ? "font-medium text-slate-900" : "text-slate-500")">@cinemaCurrent</span>
                    @if (Model.CinemaIdFilter.HasValue)
                    {
                        <span class="flex-shrink-0 rounded-full bg-indigo-100 p-0.5">
                            <svg class="h-3 w-3 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="2,6 5,9 10,3"/>
                            </svg>
                        </span>
                    }
                    <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div id="cinemaPanel"
                     class="filter-dropdown-panel absolute left-0 top-full z-50 mt-1 hidden min-w-full w-max overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                    @{
                        var isAllCinema = !Model.CinemaIdFilter.HasValue;
                    }
                    <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                            onclick="selectFilterOpt('cinemaPanel','cinemaIdInput','cinemaLabel','','Tất cả rạp',false, this)">
                        <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isAllCinema ? "" : "hidden")">
                            <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg>
                        </span>
                        <span class="filter-text @(isAllCinema ? "font-semibold text-indigo-700" : "text-slate-600")">Tất cả rạp</span>
                    </button>
                    <div class="h-px bg-slate-100 mx-2"></div>
                    @foreach (SelectListItem c in ViewBag.Cinemas)
                    {
                        var isSel = c.Value == Model.CinemaIdFilter?.ToString();
                        <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                                onclick="selectFilterOpt('cinemaPanel','cinemaIdInput','cinemaLabel','@c.Value','@Html.Raw(c.Text.Replace("'", "\\'"))',true, this)">
                            <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isSel ? "" : "hidden")">
                                <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg>
                            </span>
                            <span class="filter-text @(isSel ? "font-semibold text-indigo-700" : "text-slate-600")">@c.Text</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Status custom dropdown -->
            @{
                var statusCurrent = Model.DisplayStatusFilter switch
                {
                    1 => "Sắp chiếu",
                    2 => "Đang chiếu",
                    3 => "Đã kết thúc",
                    0 => "Đã hủy",
                    _ => "Tất cả trạng thái"
                };
                var statusInputVal = Model.DisplayStatusFilter.HasValue ? Model.DisplayStatusFilter.Value.ToString() : "";
            }
            <input type="hidden" name="displayStatus" id="statusInput" value="@statusInputVal" />
            <div class="relative sm:w-48" data-filter-dropdown>
                <button type="button" id="statusTrigger"
                        onclick="toggleFilterDropdown('statusPanel', event)"
                        class="flex w-full items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 shadow-sm hover:border-indigo-300 hover:bg-slate-50 transition-colors">
                    <svg class="h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/>
                    </svg>
                    <span id="statusLabel" class="flex-1 truncate text-left @(Model.DisplayStatusFilter.HasValue ? "font-medium text-slate-900" : "text-slate-500")">@statusCurrent</span>
                    @if (Model.DisplayStatusFilter.HasValue)
                    {
                        <span class="flex-shrink-0 rounded-full bg-indigo-100 p-0.5">
                            <svg class="h-3 w-3 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="2,6 5,9 10,3"/>
                            </svg>
                        </span>
                    }
                    <svg class="h-3.5 w-3.5 flex-shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div id="statusPanel"
                     class="filter-dropdown-panel absolute left-0 top-full z-50 mt-1 hidden min-w-full w-max overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
                    @{ var isAllStatus = !Model.StatusFilter.HasValue; }
                    <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                            onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','','Tất cả trạng thái',false, this)">
                        <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isAllStatus ? "" : "hidden")">
                            <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg> 
                        </span>
                        <span class="filter-text @(isAllStatus ? "font-semibold text-indigo-700" : "text-slate-600")">Tất cả trạng thái</span>
                    </button>
                    <div class="h-px bg-slate-100 mx-2"></div>
                    @{
                        var isUpcoming = Model.DisplayStatusFilter == 1;
                        var isNowShowing = Model.DisplayStatusFilter == 2;
                        var isEnded = Model.DisplayStatusFilter == 3;
                        var isCancelled = Model.DisplayStatusFilter == 0;
                    }
                    <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                            onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','1','Sắp chiếu',true, this)">
                        <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isUpcoming ? "" : "hidden")">
                            <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg> 
                        </span>
                        <span class="filter-text flex items-center gap-2 @(isUpcoming ? "font-semibold text-indigo-700" : "text-slate-600")">
                            Sắp chiếu
                        </span>
                    </button>
                    <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                            onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','2','Đang chiếu',true, this)">
                        <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isNowShowing ? "" : "hidden")">
                            <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg> 
                        </span>
                        <span class="filter-text flex items-center gap-2 @(isNowShowing ? "font-semibold text-indigo-700" : "text-slate-600")">
                            Đang chiếu
                        </span>
                    </button>
                    <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                            onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','3','Đã kết thúc',true, this)">
                        <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isEnded ? "" : "hidden")">
                            <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg> 
                        </span>
                        <span class="filter-text flex items-center gap-2 @(isEnded ? "font-semibold text-indigo-700" : "text-slate-600")">
                            Đã kết thúc
                        </span>
                    </button>
                    <button type="button" class="relative flex w-full items-center justify-start pl-11 pr-4 py-2.5 text-sm text-left hover:bg-slate-50 transition-colors whitespace-nowrap"
                            onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','0','Đã hủy',true, this)">
                        <span class="absolute left-4 flex h-5 w-5 items-center justify-center filter-tick @(isCancelled ? "" : "hidden")">
                            <svg class="h-4 w-4 text-indigo-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="2,6 5,9 10,3"/></svg> 
                        </span>
                        <span class="filter-text flex items-center gap-2 @(isCancelled ? "font-semibold text-indigo-700" : "text-slate-600")">
                            Đã hủy
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Submit -->
        <button type="submit"
                class="flex items-center gap-2 bg-slate-900 text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-slate-800 transition-all active:scale-[0.98] whitespace-nowrap">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
            </svg>
            Lọc
        </button>

        <a id="clearFilterBtn" href="/ShowTimes/Index" class="text-sm text-slate-400 hover:text-slate-600 transition-colors font-medium underline whitespace-nowrap @(string.IsNullOrEmpty(Model.SearchTerm) && !Model.DateFilter.HasValue && !Model.CinemaIdFilter.HasValue && !Model.StatusFilter.HasValue && !Model.DisplayStatusFilter.HasValue ? "hidden" : "")">Xóa bộ lọc</a>
    </form>

    <!-- ShowTime Cards Container for AJAX -->
    <div id="showtime-list-container">
        <partial name="_ShowTimeListPartial" model="Model" />
    </div>
</div>

<!-- Create Showtime Modal -->
<div id="CreateModal" class="fixed inset-0 z-[90] hidden opacity-0 transition-opacity duration-300 pointer-events-none" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Overlay -->
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] transition-opacity pointer-events-auto" aria-hidden="true" onclick="toggleModal(false)"></div>
    
    <div class="fixed inset-0 overflow-y-auto pointer-events-none">
        <div class="flex min-h-screen items-center justify-center p-4">
            <!-- Modal Content -->
            <div id="CreateModalContent" class="relative w-full max-w-2xl transform overflow-hidden rounded-[2rem] bg-white text-left align-middle shadow-2xl transition-all translate-y-0 duration-300 pointer-events-auto flex flex-col max-h-[90vh]">
        
        <!-- Header -->
        <div class="px-8 py-6 border-b border-gray-100 flex justify-between items-center bg-white flex-shrink-0">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Tạo suất chiếu mới</h1>
                <p class="text-slate-500 text-xs mt-1">Thêm suất chiếu mới vào lịch chiếu hệ thống</p>
            </div>
            <button id="CloseModalBtn" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-100 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Form Body -->
        <div class="bg-white flex-1 overflow-y-auto custom-scrollbar">
            <form asp-action="Create" method="post" id="CreateForm" class="px-8 py-6 space-y-6">
                @Html.AntiForgeryToken()
                
                <!-- Movie Selection -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700">Phim <span class="text-red-500">*</span></label>
                    <input type="hidden" asp-for="CreateForm.MovieId" id="MovieIdInput" />
                    <div class="relative" data-custom-dropdown>
                        <button type="button" id="MovieTrigger" onclick="toggleDropdown('MoviePanel', event)" 
                                class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm hover:border-slate-300 hover:bg-slate-50 transition-all focus:ring-2 focus:ring-slate-900/10 outline-none">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                            </svg>
                            <span id="MovieLabel" class="flex-1 text-left font-bold text-slate-800">Chọn phim</span>
                            <svg class="h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </button>
                        <div id="MoviePanel" class="absolute left-0 top-full z-[60] mt-1 hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl max-h-60 overflow-y-auto custom-scrollbar">
                            @foreach (var m in Model.CreateForm?.Movies ?? Enumerable.Empty<SelectListItem>())
                            {
                                <button type="button" onclick="selectOption('MoviePanel', 'MovieIdInput', 'MovieLabel', '@m.Value', '@m.Text', 'movie')" 
                                        class="flex w-full items-center px-4 py-3 text-sm text-slate-700 hover:bg-slate-50 transition-colors font-bold border-b border-slate-50 last:border-0 text-left">
                                    @m.Text
                                </button>
                            }
                        </div>
                    </div>
                    <div id="MovieInfo" class="hidden text-[11px] text-slate-500 flex items-center gap-1.5 ml-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Thời lượng: <span id="MovieDurationText" class="font-bold text-slate-700">0</span> phút + 15 phút dọn dẹp = <span id="TotalDurationText" class="font-bold text-slate-700">0</span> phút
                    </div>
                </div>

                <!-- Room Selection -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700">Phòng chiếu <span class="text-red-500">*</span></label>
                    <input type="hidden" asp-for="CreateForm.RoomId" id="RoomIdInput" />
                    <div class="relative" data-custom-dropdown>
                        <button type="button" id="RoomTrigger" onclick="toggleDropdown('RoomPanel', event)" 
                                class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm hover:border-slate-300 hover:bg-slate-50 transition-all focus:ring-2 focus:ring-slate-900/10 outline-none">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                            <span id="RoomLabel" class="flex-1 text-left font-bold text-slate-800">Chọn phòng</span>
                            <svg class="h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </button>
                        <div id="RoomPanel" class="absolute left-0 top-full z-[60] mt-1 hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl max-h-60 overflow-y-auto custom-scrollbar">
                            @{
                                var rooms = Model.CreateForm?.Rooms ?? Enumerable.Empty<SelectListItem>();
                                var groupedRooms = rooms.GroupBy(r => r.Group?.Name ?? "Khác");
                                foreach (var group in groupedRooms)
                                {
                                    <div class="bg-slate-50 px-4 py-2 text-[10px] font-extrabold text-slate-500 uppercase tracking-widest border-b border-slate-100">
                                        @group.Key
                                    </div>
                                    foreach (var r in group)
                                    {
                                        <button type="button" onclick="selectOption('RoomPanel', 'RoomIdInput', 'RoomLabel', '@r.Value', '@r.Text', 'room')" 
                                                class="flex w-full items-center px-4 py-3 text-sm text-slate-700 hover:bg-slate-50 transition-colors font-bold border-b border-slate-50 last:border-0 text-left">
                                            @r.Text
                                        </button>
                                    }
                                }
                            }
                        </div>
                    </div>
                    <div id="RoomDetail" class="hidden text-[11px] text-slate-500 flex items-center gap-1.5 ml-1 animate-in fade-in slide-in-from-left-2 duration-300">
                        <span id="RoomDetailText" class="font-medium text-slate-500"></span>
                    </div>
                </div>

                <!-- Show Time -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700">Giờ chiếu <span class="text-red-500">*</span></label>
                    <input asp-for="CreateForm.StartAt" id="StartTimeInput" type="datetime-local" 
                           value='@(Model.CreateForm?.StartAt.ToString("yyyy-MM-ddTHH:mm") ?? "")' 
                           class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all text-slate-800 font-bold text-sm shadow-sm" />
                    
                    <div id="TimePreview" class="hidden bg-blue-50 border border-blue-100 rounded-xl p-3 flex items-center gap-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-blue-800 text-xs font-bold">Thời gian dự kiến: <span id="TimeRangeDisplay" class="font-extrabold underline decoration-blue-300">00:00 - 00:00</span></span>
                    </div>
                </div>

                <!-- Pricing -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700">Giá vé cơ bản (Standard) <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 font-bold text-sm">$</div>
                        <input asp-for="CreateForm.BasePrice" asp-format="{0:N0}" id="BasePriceInput" type="text" class="w-full bg-white border border-slate-200 rounded-xl pl-8 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all text-slate-800 font-bold text-base shadow-sm" placeholder="80,000" />
                    </div>
                    
                    <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-4 space-y-2">
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 mx-1">Giá theo loại ghế</p>
                        <div class="grid grid-cols-1 gap-1.5 px-1">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-600 font-medium font-bold italic">• Standard</span>
                                <span id="PriceStandard" class="font-extrabold text-slate-900">0 VNĐ</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-600 font-medium font-bold italic">• VIP <span class="text-[10px] font-normal text-blue-500">(+20,000)</span></span>
                                <span id="PriceVIP" class="font-extrabold text-slate-900">0 VNĐ</span>
                            </div>
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-600 font-medium font-bold italic">• Couple <span class="text-[10px] font-normal text-pink-500">(+50,000)</span></span>
                                <span id="PriceCouple" class="font-extrabold text-slate-900">0 VNĐ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status Bar -->
                <div id="ValidationBar" class="hidden rounded-xl py-2.5 px-4 border flex items-center gap-2.5 transition-all">
                    <div id="ValidationIcon"></div>
                    <span id="ValidationText" class="text-xs font-bold"></span>
                </div>
            </form>
        </div>

        <!-- Footer -->

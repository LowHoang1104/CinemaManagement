<!-- Cancel Showtime Confirmation Modal -->
<div id="CancelModal" class="fixed inset-0 z-[100] hidden opacity-0 transition-opacity duration-300 pointer-events-none" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] transition-opacity pointer-events-auto" onclick="toggleCancelModal(false)"></div>
    <div class="fixed inset-0 overflow-y-auto pointer-events-none">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div id="CancelModalContent" class="relative w-full max-w-2xl transform overflow-hidden rounded-[2rem] bg-white text-left align-middle shadow-2xl transition-all -translate-y-full duration-300 pointer-events-auto flex flex-col max-h-[90vh]">
                <div class="px-8 pt-8 pb-6 text-center flex-shrink-0 sticky top-0 bg-white z-10">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-red-50 mb-6">
                        <svg class="w-8 h-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    </div>
                    <h3 class="text-2xl font-extrabold text-slate-900 mb-4">Hủy suất chiếu</h3>
                    <p class="text-slate-600 font-medium">
                        Bạn có chắc chắn muốn hủy suất chiếu <span id="CancelMovieName" class="font-bold text-slate-900"></span> 
                        vào <span id="CancelTime" class="font-bold text-slate-900"></span> ngày <span id="CancelDate" class="font-bold text-slate-900"></span>?
                    </p>
                </div>

                <div class="px-8 py-6 flex-1 overflow-y-auto custom-scrollbar">
                    <div class="bg-red-50 border border-red-100 rounded-xl px-5 py-4 space-y-3">
                        <div class="flex items-center gap-2 text-red-800 font-bold mb-1">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            Lưu ý quan trọng:
                        </div>
                        <ul class="text-red-700 text-sm font-medium space-y-2.5 ml-1">
                            <li class="flex items-end gap-2">
                                <span class="text-red-400 mt-1">•</span>
                                <span>Đây là thao tác quản lý vòng đời suất chiếu</span>
                            </li>
                            <li class="flex items-end gap-2">
                                <span class="text-red-400 mt-1">•</span>
                                <span>Thao tác có thể thất bại nếu đã có khách hàng đặt vé</span>
                            </li>
                            <li class="flex items-end gap-2">
                                <span class="text-red-400 mt-1">•</span>
                                <span>Nếu có vé đã đặt, cần hoàn tiền cho khách hàng trước</span>
                            </li>
                            <li class="flex items-end gap-2">
                                <span class="text-red-400 mt-1">•</span>
                                <span>Suất chiếu sẽ chuyển sang trạng thái "Đã hủy"</span>
                            </li>
                            <li class="flex items-end gap-2">
                                <span class="text-red-400 mt-1">•</span>
                                <span>Không thể kích hoạt lại suất chiếu đã hủy</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-4 bg-blue-50 border border-blue-100 rounded-xl p-4 flex gap-3 items-start">
                        <div class="flex-1 text-blue-700 text-xs leading-relaxed">
                            <span class="font-bold">Khuyến nghị:</span> Chỉ hủy suất chiếu khi thực sự cần thiết (lỗi kỹ thuật, thiếu nhân viên, v.v.)
                        </div>
                    </div>
                </div>

                <div class="px-8 py-6 border-t border-gray-100 bg-gray-50 flex gap-3 flex-shrink-0">
                    <button type="button" onclick="toggleCancelModal(false)" 
                            class="flex-1 px-6 py-3 bg-white border border-slate-200 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition-all text-sm shadow-sm active:scale-95">
                        Giữ lại
                    </button>
                    <button type="button" id="ConfirmCancelBtn" 
                            class="flex-[1.5] px-6 py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 transition-all shadow-xl shadow-red-100 text-sm active:scale-95">
                        Xác nhận hủy
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        window.movieDurations = @Html.Raw(JsonSerializer.Serialize(Model.MovieDurations));
        window.roomLocations = @Html.Raw(JsonSerializer.Serialize(Model.RoomLocations));
        
        @if (!ViewData.ModelState.IsValid) {
            <text>
                setTimeout(() => {
                    window.toggleModal(true); 
                    window.initDropdownLabels();
                    if (window.showToast) window.showToast('Lỗi dữ liệu', 'Vui lòng kiểm tra lại.', 'error');
                }, 100);
            </text>
        }
        @if (TempData["SuccessMessage"] != null) {
            <text>
                setTimeout(() => {
                    if (window.showToast) window.showToast('Thành công', '@TempData["SuccessMessage"]', 'success');
                }, 100);
            </text>
        }
    </script>
    <script src="~/js/admin/showtime-index.js" asp-append-version="true"></script>
}

@model CinemaManagement.ViewModels.ShowTimeEditViewModel
@{
    bool viewOnly = Context.Request.Query["viewOnly"] == "true";
}

<div class="bg-white">
    <form asp-action="Edit" asp-route-id="@Model.ShowTimeId" method="post" id="EditForm" class="px-8 py-6 space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ShowTimeId" />


        <!-- Movie Selection (Read-only) -->
        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700">Phim <span class="text-red-500">*</span></label>
            <div class="relative opacity-60">
                <button type="button" disabled
                        class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 shadow-sm cursor-not-allowed">
                    <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                    </svg>
                    <span class="flex-1 text-left font-bold text-slate-800">@Model.MovieTitle (@Model.MovieDuration phút)</span>
                    <svg class="h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <div class="text-[11px] text-slate-400 flex items-center gap-1.5 ml-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Thời lượng: @Model.MovieDuration phút + 15 phút dọn dẹp = @(Model.MovieDuration + 15) phút
            </div>
            <p class="text-[10px] text-blue-500 font-medium ml-1 italic">Không thể thay đổi phim sau khi tạo</p>
        </div>

        <!-- Room Selection (Read-only) -->
        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700">Phòng chiếu <span class="text-red-500">*</span></label>
            <div class="relative opacity-60">
                <button type="button" disabled 
                        class="flex w-full items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 shadow-sm cursor-not-allowed">
                    <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    <span class="flex-1 text-left font-bold text-slate-800">@Model.RoomName</span>
                    <svg class="h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1.5 ml-1">
                📍 @Model.CinemaName - @Model.RoomName - Standard
            </div>
            <p class="text-[10px] text-blue-500 font-medium ml-1 italic">Không thể thay đổi phòng chiếu sau khi tạo</p>
        </div>

        <!-- Show Time -->
        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700">Giờ chiếu <span class="text-red-500">*</span></label>
            <input asp-for="StartAt" id="EditStartTimeInput" type="datetime-local" 
                   value='@Model.StartAt.ToString("yyyy-MM-ddTHH:mm")' 
                   disabled="@(viewOnly ? "disabled" : null)"
                   class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all text-slate-800 font-bold text-sm shadow-sm @(viewOnly ? "opacity-60 bg-slate-50 cursor-not-allowed" : "")" />
            
            <div id="EditTimePreview" class="bg-blue-50 border border-blue-100 rounded-xl p-3 flex items-center gap-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-blue-800 text-xs font-bold">Thời gian dự kiến: <span id="EditTimeRangeDisplay" class="font-extrabold underline decoration-blue-300">00:00 - 00:00</span></span>
            </div>
        </div>

        <!-- Pricing -->
        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700">Giá vé cơ bản (Standard) <span class="text-red-500">*</span></label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 font-bold text-sm">$</div>
                <input asp-for="BasePrice" asp-format="{0:N0}" id="EditBasePriceInput" type="text" 
                       disabled="@(viewOnly ? "disabled" : null)"
                       class="w-full bg-white border border-slate-200 rounded-xl pl-8 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-400 transition-all text-slate-800 font-bold text-base shadow-sm @(viewOnly ? "opacity-60 bg-slate-50 cursor-not-allowed" : "")" />
            </div>
            
            <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-4 space-y-2">
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 mx-1">Giá theo loại ghế</p>
                <div class="grid grid-cols-1 gap-1.5 px-1">
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-600 font-medium font-bold italic">• Standard</span>
                        <span id="EditPriceStandard" class="font-extrabold text-slate-900">0 VNĐ</span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-600 font-medium font-bold italic">• VIP <span class="text-[10px] font-normal text-blue-500">(+5,000)</span></span>
                        <span id="EditPriceVIP" class="font-extrabold text-slate-900">0 VNĐ</span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-slate-600 font-medium font-bold italic">• Couple <span class="text-[10px] font-normal text-pink-500">(x2)</span></span>
                        <span id="EditPriceCouple" class="font-extrabold text-slate-900">0 VNĐ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status Bar -->
        <div id="EditValidationBar" class="rounded-xl py-2.5 px-4 border flex items-center gap-2.5 transition-all hidden">
            <div id="EditValidationIcon"></div>
            <span id="EditValidationText" class="text-xs font-bold"></span>
        </div>

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs font-bold bg-red-50 border border-red-200 rounded-xl p-4 mb-4 empty:hidden"></div>
    </form>
</div>

<script>
    (function() {
        window.editModalData = {
            viewOnly: @(viewOnly ? "true" : "false"),
            movieDuration: @Model.MovieDuration,
            roomId: '@Model.RoomId',
            showTimeId: '@Model.ShowTimeId',
            movieId: '@Model.MovieId',
            movieTitle: '@Html.Raw(Model.MovieTitle.Replace("'", "\\'"))'
        };
    })();
</script>
<script src="~/js/admin/showtime-edit-modal.js" asp-append-version="true"></script>

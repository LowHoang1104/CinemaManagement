@model CinemaManagement.ViewModels.AdminMovies.AdminMovieViewModel
@{
    ViewData["Title"] = "Edit Movie";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Cập nhật phim</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.MovieId" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="MovieId" type="hidden" />
            <partial name="_MovieForm" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-light">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IReadOnlyList<CinemaManagement.ViewModels.AdminMovies.AdminMovieViewModel>
@{
    ViewData["Title"] = "Movie Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Movie Management (TCP)</h2>
        <p class="text-muted mb-0">CRUD movie qua ServiceMovieAdmin dùng TCP NetworkStream.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Thêm phim
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên phim</th>
                        <th>Thời lượng</th>
                        <th>Độ tuổi</th>
                        <th>Ngày phát hành</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Chưa có dữ liệu phim hoặc TCP service chưa phản hồi.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@movie.Title</div>
                                    <small class="text-muted">@movie.Genre</small>
                                </td>
                                <td>@movie.DurationMin phút</td>
                                <td>@(movie.AgeRating?.ToString() ?? "N/A")</td>
                                <td>@(movie.ReleaseDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>
                                    @if (movie.Status == 1)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-outline-primary me-2">
                                        Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@movie.MovieId" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn muốn xóa phim này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

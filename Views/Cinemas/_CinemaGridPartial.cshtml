@model CinemaManagement.ViewModels.Cinema.CinemaIndexViewModel

@{
    var searchKeyword = Model.SearchKeyword;
    var statusFilter = Model.StatusFilter;
    var sortBy = Model.SortBy;
    var sortDir = Model.SortDir;
    var currentPage = Model.CurrentPage;
    var totalPages = Model.TotalPages;
    var totalItems = Model.TotalItems;
    var pageSize = Model.PageSize;

    var statusLabel = statusFilter switch {
        1 => "Hoạt động",
        0 => "Ngừng hoạt động",
        _ => null
    };
    var sortLabel = sortBy switch {
        "name" => "Tên (A-Z)",
        "rooms" => "Số phòng",
        _ => null
    };
    bool hasFilters = statusFilter.HasValue || !string.IsNullOrWhiteSpace(searchKeyword) || !string.IsNullOrWhiteSpace(sortBy);

    string PageUrl(int p) {
        var qs = new System.Collections.Generic.Dictionary<string, string?> {
            ["page"] = p.ToString(),
            ["search"] = Model.SearchKeyword,
            ["status"] = Model.StatusFilter?.ToString(),
            ["sortBy"] = Model.SortBy,
            ["sortDir"] = Model.SortDir
        };
        var parts = qs
            .Where(kv => !string.IsNullOrEmpty(kv.Value))
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}")
            .ToList();
        return "/Cinemas/Index?" + string.Join("&", parts);
    }
}

@* Teleport sections for AJAX UI Sync *@
<div id="teleport-ajax-clear-filter-wrapper" class="hidden">
    @if (hasFilters)
    {
        <a href="/Cinemas/Index" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm h-[42px]">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
            Xóa bộ lọc
        </a>
    }
</div>

<div id="teleport-ajax-chips-wrapper" class="hidden">
    @if (hasFilters)
    {
        <div class="flex flex-wrap items-center gap-2 pt-2">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mr-2">Đang áp dụng:</span>
            @if (!string.IsNullOrWhiteSpace(searchKeyword)) {
                <div class="flex items-center gap-1.5 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">
                    <span>Từ khóa: @searchKeyword</span>
                </div>
            }
            @if (statusLabel != null) {
                <div class="flex items-center gap-1.5 rounded-lg bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 border border-indigo-100">
                    <span>@statusLabel</span>
                </div>
            }
            @if (sortLabel != null) {
                <div class="flex items-center gap-1.5 rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 border border-amber-100">
                    <span>Sắp xếp: @sortLabel</span>
                </div>
            }
            <span class="ml-1 text-xs text-slate-400">— Tìm thấy <strong class="text-slate-600">@totalItems</strong> rạp chiếu</span>
        </div>
    }
</div>

<div id="cinema-grid-ajax-content">
    @if (!Model.Cinemas.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-[2.5rem] border border-dashed border-slate-300">
            <div class="h-20 w-20 bg-slate-50 rounded-3xl flex items-center justify-center text-slate-300 mb-6">
                <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Không tìm thấy rạp nào</h3>
            <p class="text-slate-500 mt-2">Vui lòng thử lại với bộ lọc khác hoặc thêm rạp mới</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var c in Model.Cinemas)
            {
                <div class="group relative flex flex-col rounded-[2.25rem] bg-white border border-slate-100 p-6 shadow-sm transition-all hover:shadow-xl hover:border-indigo-200/50 hover:-translate-y-1">
                    
                    @* Card Decoration Status *@
                    <div class="absolute top-0 right-10 h-1 w-12 rounded-b-full @(c.Status == 1 ? "bg-emerald-400" : "bg-slate-300")"></div>

                    @* Card Header *@
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex-1 pr-4">
                            @* Visible Status Indicator *@
                            <div class="mb-2">
                                @if (c.Status == 1) {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-[10px] font-black text-emerald-600 border border-emerald-100/50">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> HOẠT ĐỘNG
                                    </span>
                                } else {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-50 text-[10px] font-black text-slate-400 border border-slate-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span> NGỪNG HOẠT ĐỘNG
                                    </span>
                                }
                            </div>
                            <h3 class="text-xl font-black text-slate-900 tracking-tight leading-tight" title="@c.Name">@c.Name</h3>
                        </div>

                        @* Action Button (⋮) *@
                        <div class="relative" data-action-root>
                            <button type="button" onclick="toggleActionMenu('menu-@c.CinemaId', event)"
                                    class="flex h-10 w-10 items-center justify-center rounded-2xl bg-slate-50 text-slate-400 hover:bg-white hover:text-indigo-600 hover:shadow-md hover:border-indigo-100 border border-transparent transition-all active:scale-90 shadow-sm">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                            </button>
                            
                            @* Premium Action Menu *@
                            <div id="menu-@c.CinemaId" class="invisible absolute right-0 top-full z-40 mt-3 w-56 origin-top-right rounded-[1.75rem] border border-slate-100 bg-white/95 backdrop-blur-md p-2 shadow-2xl transition-all opacity-0 scale-95 ring-1 ring-slate-900/5">
                                <div class="px-3 py-2 text-[10px] font-black text-slate-400 uppercase tracking-widest">Hành động</div>
                                <button type="button" onclick="openCinemaEdit('@c.CinemaId')" class="group flex w-full items-center gap-3 px-3 py-2.5 rounded-2xl hover:bg-slate-50 text-sm font-bold text-slate-700 transition-all text-left">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-50 text-slate-400 group-hover:bg-slate-100 group-hover:text-slate-600 transition-colors border border-slate-100">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                    </div>
                                    Chỉnh sửa thông tin
                                </button>
                                <div class="my-1.5 h-px bg-slate-100 mx-2"></div>
                                @if (c.Status == 1) {
                                    <button type="button" onclick="openStatusModal('deactivate', '@c.CinemaId', '@c.Name')" class="group flex w-full items-center gap-3 px-3 py-2.5 rounded-2xl hover:bg-rose-50 text-sm font-bold text-rose-600 transition-all">
                                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-rose-50 text-rose-500 group-hover:bg-rose-100 transition-colors">
                                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>
                                            </svg>
                                        </span>
                                        Ngừng hoạt động
                                    </button>
                                } else {
                                    <button type="button" onclick="openStatusModal('activate', '@c.CinemaId', '@c.Name')" class="group flex w-full items-center gap-3 px-3 py-2.5 rounded-2xl hover:bg-emerald-50 text-sm font-bold text-emerald-600 transition-all">
                                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-50 text-emerald-500 group-hover:bg-emerald-100 transition-colors">
                                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                                                    </svg>
                                                </span>
                                        Kích hoạt rạp
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @* Card Body *@
                    <div class="flex-1 space-y-4">
                        <div class="flex items-start gap-3 p-3 rounded-2xl bg-slate-50/50 border border-slate-100/50">
                            <div class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-white text-indigo-400 shadow-sm border border-slate-100">
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            </div>
                            <p class="text-[13px] font-semibold text-slate-500 line-clamp-2 leading-relaxed italic">@c.Address</p>
                        </div>
                    </div>

                    @* Card Footer *@
                    <div class="mt-6 flex items-center justify-between pt-5 border-t border-slate-100">
                         <div class="flex items-center gap-2">
                            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-50 text-amber-500 shadow-sm">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            </div>
                            <span class="text-[11px] font-black text-slate-700 tracking-wider uppercase">@c.Rooms.Count <span class="text-slate-400 font-bold ml-0.5">phòng chiếu</span></span>
                        </div>
                        <a href="@Url.Action("Details", "Cinemas", new { id = c.CinemaId })" class="px-6 py-2.5 rounded-full text-[11px] font-black text-white bg-gradient-to-r from-indigo-500 via-indigo-600 to-violet-600 hover:from-indigo-600 hover:to-violet-700 transition-all shadow-lg shadow-indigo-200 hover:shadow-indigo-300 active:scale-95 uppercase tracking-wider inline-flex items-center justify-center">
                            Chi tiết
                        </a>
                    </div>
                </div>
            }
        </div>

        <partial name="_PaginationPartial" model="@(new CinemaManagement.ViewModels.Shared.PaginationViewModel {
            CurrentPage = currentPage,
            TotalPages = totalPages,
            TotalItems = totalItems,
            PageSize = pageSize,
            GenerateUrl = PageUrl
        })" />
    }
</div>

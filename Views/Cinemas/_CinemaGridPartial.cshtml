@model CinemaManagement.ViewModels.Cinema.CinemaIndexViewModel

@{
    var searchKeyword = Model.SearchKeyword;
    var statusFilter = Model.StatusFilter;
    var sortBy = Model.SortBy;
    var sortDir = Model.SortDir;
    var currentPage = Model.CurrentPage;
    var totalPages = Model.TotalPages;
    var totalItems = Model.TotalItems;
    var pageSize = Model.PageSize;

    var statusLabel = statusFilter switch {
        1 => "Hoạt động",
        0 => "Ngừng hoạt động",
        _ => null
    };
    var sortLabel = sortBy switch {
        "name" => "Tên (A-Z)",
        "rooms" => "Số phòng",
        _ => null
    };
    bool hasFilters = statusFilter.HasValue || !string.IsNullOrWhiteSpace(searchKeyword) || !string.IsNullOrWhiteSpace(sortBy);

    string PageUrl(int p) {
        var qs = new System.Collections.Generic.Dictionary<string, string?> {
            ["page"] = p.ToString(),
            ["search"] = Model.SearchKeyword,
            ["status"] = Model.StatusFilter?.ToString(),
            ["sortBy"] = Model.SortBy,
            ["sortDir"] = Model.SortDir
        };
        var parts = qs
            .Where(kv => !string.IsNullOrEmpty(kv.Value))
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}")
            .ToList();
        return "/Cinemas/Index?" + string.Join("&", parts);
    }
}

@* Teleport sections for AJAX UI Sync *@
<div id="teleport-ajax-clear-filter-wrapper" class="hidden">
    @if (hasFilters)
    {
        <a href="/Cinemas/Index" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm h-[42px]">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
            Xóa bộ lọc
        </a>
    }
</div>

<div id="teleport-ajax-chips-wrapper" class="hidden">
    @if (hasFilters)
    {
        <div class="flex flex-wrap items-center gap-2 pt-2">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mr-2">Đang áp dụng:</span>
            @if (!string.IsNullOrWhiteSpace(searchKeyword)) {
                <div class="flex items-center gap-1.5 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">
                    <span>Từ khóa: @searchKeyword</span>
                </div>
            }
            @if (statusLabel != null) {
                <div class="flex items-center gap-1.5 rounded-lg bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 border border-indigo-100">
                    <span>@statusLabel</span>
                </div>
            }
            @if (sortLabel != null) {
                <div class="flex items-center gap-1.5 rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 border border-amber-100">
                    <span>Sắp xếp: @sortLabel</span>
                </div>
            }
            <span class="ml-1 text-xs text-slate-400">— Tìm thấy <strong class="text-slate-600">@totalItems</strong> rạp chiếu</span>
        </div>
    }
</div>

<div id="cinema-grid-ajax-content">
    @if (!Model.Cinemas.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-[2.5rem] border border-dashed border-slate-300">
            <div class="h-20 w-20 bg-slate-50 rounded-3xl flex items-center justify-center text-slate-300 mb-6">
                <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Không tìm thấy rạp nào</h3>
            <p class="text-slate-500 mt-2">Vui lòng thử lại với bộ lọc khác hoặc thêm rạp mới</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-[2rem] border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-200">
                        <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-center w-16">#</th>
                        <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Tên rạp</th>
                        <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Địa chỉ</th>
                        <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-center">Phòng chiếu</th>
                        <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest">Trạng thái</th>
                        <th class="px-6 py-4 text-[11px] font-black text-slate-400 uppercase tracking-widest text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{
                        int index = (currentPage - 1) * pageSize + 1;
                    }
                    @foreach (var c in Model.Cinemas)
                    {
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 text-center">
                                <span class="text-sm font-bold text-slate-400">@(index++)</span>
                            </td>
                            <td class="px-6 py-4">
                                <a href="@Url.Action("Details", "Cinemas", new { id = c.CinemaId })" class="text-sm font-black text-slate-900 line-clamp-1 hover:text-indigo-600 transition-colors">@c.Name</a>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-[13px] font-semibold text-slate-500 line-clamp-1 italic" title="@c.Address">@c.Address</p>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-50 text-[11px] font-black text-amber-600 border border-amber-100/50">
                                    @c.Rooms.Count
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                @if (c.Status == 1) {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-[10px] font-black text-emerald-600 border border-emerald-100/50">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> HOẠT ĐỘNG
                                    </span>
                                } else {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-50 text-[10px] font-black text-slate-400 border border-slate-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span> NGỪNG HOẠT ĐỘNG
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @* Quick Action Button (⋮) *@
                                    <div class="relative" data-action-root>
                                        <button type="button" id="action-trigger-@c.CinemaId" onclick="cinema_toggleActionMenu('menu-@c.CinemaId', event)"
                                                class="flex h-9 w-9 items-center justify-center rounded-lg bg-white text-slate-400 border border-slate-200 hover:text-slate-600 hover:border-slate-300 hover:bg-slate-50 transition-all shadow-sm active:scale-95">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                                        </button>
                                        
                                        @* Action Menu *@
                                        <div id="menu-@c.CinemaId" class="invisible absolute right-0 top-full z-40 mt-1 w-56 origin-top-right rounded-2xl border border-slate-100 bg-white shadow-2xl transition-all opacity-0 scale-95 ring-1 ring-slate-900/5 p-2">
                                            <div class="px-3 py-1.5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Hành động</div>
                                            <button type="button" onclick="cinema_openCinemaEdit('@c.CinemaId')" class="group flex w-full items-center gap-3 px-3 py-2 rounded-xl hover:bg-slate-50 text-sm font-bold text-slate-700 transition-all text-left">
                                                <svg class="h-4 w-4 text-slate-400 group-hover:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                                Chỉnh sửa
                                            </button>
                                            <div class="my-1 h-px bg-slate-100"></div>
                                            @if (c.Status == 1) {
                                                <button type="button" class="flex w-full items-center gap-3 px-3 py-2 text-left text-rose-600 hover:bg-rose-50 transition-colors group rounded-xl font-bold text-sm" onclick="cinema_openStatusModal('deactivate', '@c.CinemaId', '@c.Name')">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    Ngừng hoạt động
                                                </button>
                                            } else {
                                                <button type="button" class="flex w-full items-center gap-3 px-3 py-2 text-left text-emerald-600 hover:bg-emerald-50 transition-colors group rounded-xl font-bold text-sm" onclick="cinema_openStatusModal('activate', '@c.CinemaId', '@c.Name')">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    Kích hoạt rạp
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_PaginationPartial" model="@(new CinemaManagement.ViewModels.Shared.PaginationViewModel {
            CurrentPage = currentPage,
            TotalPages = totalPages,
            TotalItems = totalItems,
            PageSize = pageSize,
            GenerateUrl = PageUrl
        })" />
    }
</div>

@model CinemaManagement.ViewModels.Cinema.CinemaIndexViewModel

@{
    ViewData["Title"] = "Quản lý Rạp chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalCinemas = Model.Stats.TotalCinemas;
    var activeCinemas = Model.Stats.ActiveCinemas;
    var inactiveCinemas = Model.Stats.InactiveCinemas;
    var totalRooms = Model.Stats.TotalRooms;

    var searchKeyword = Model.SearchKeyword;
    var statusFilter = Model.StatusFilter;
    var sortBy = Model.SortBy;
    var totalItems = Model.TotalItems;

    // Filter label helpers
    var statusLabel = statusFilter switch {
        0 => "Ngừng hoạt động",
        1 => "Hoạt động",
        _ => null
    };
    var sortLabel = sortBy switch {
        "name" => "Tên (A-Z)",
        "rooms" => "Số phòng",
        _ => null
    };
    bool hasFilters = statusFilter.HasValue || !string.IsNullOrWhiteSpace(searchKeyword) || !string.IsNullOrWhiteSpace(sortBy);
}

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-slate-50/80 py-8">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-7">
        
        @* ── Header ── *@
        <div class="flex items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-slate-900">Quản lý Rạp chiếu</h1>
                <p class="mt-1 text-sm text-slate-500">Thông tin chi tiết và trạng thái hoạt động của các rạp</p>
            </div>
            <button type="button" onclick="openCinemaCreate()"
               class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-slate-200 hover:bg-slate-700 transition-all hover:-translate-y-0.5 active:translate-y-0">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                Thêm rạp mới
            </button>
        </div>

        @* ── Statistics ── *@
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            @* Total *@
            <div class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-500 shadow-sm border border-indigo-100/50">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">Tổng số rạp</p>
                        <p class="text-2xl font-black text-slate-900 leading-tight">@totalCinemas</p>
                    </div>
                </div>
            </div>
            @* Active *@
            <div class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-500 shadow-sm border border-emerald-100/50">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">Hoạt động</p>
                        <p class="text-2xl font-black text-emerald-600 leading-tight">@activeCinemas</p>
                    </div>
                </div>
            </div>
            @* Inactive *@
            <div class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-rose-50 text-rose-500 shadow-sm border border-rose-100/50">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 9l-6 6M9 9l6 6"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 text-slate-400">Ngừng hoạt động</p>
                        <p class="text-2xl font-black text-rose-600 leading-tight">@inactiveCinemas</p>
                    </div>
                </div>
            </div>
            @* Total Rooms *@
            <div class="relative overflow-hidden rounded-[1rem] border border-slate-100 bg-white p-6 shadow-sm transition-all hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-500 shadow-sm border border-amber-100/50">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400 text-slate-400">Tổng số phòng</p>
                        <p class="text-2xl font-black text-amber-600 leading-tight">@totalRooms</p>
                    </div>
                </div>
            </div>
        </div>

        @* ── Filter Panel ── *@
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Bộ lọc & Tìm kiếm</p>
            </div>

            <form id="cinemaFilterForm" method="get" asp-action="Index" class="space-y-4">
                <div class="flex flex-col gap-3 lg:flex-row items-stretch">
                    @* Search *@
                    <div class="relative flex-1 group">
                        <input type="text" name="search" value="@searchKeyword" placeholder="Tìm tên rạp, địa chỉ..."
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-[14px] font-medium text-slate-900 outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-50 transition-all placeholder:text-slate-400 shadow-sm" />
                    </div>

                    @* Status Dropdown *@
                    <input type="hidden" name="status" id="statusInput" value="@(statusFilter?.ToString() ?? "")" />
                    <div class="relative lg:w-48" data-filter-dropdown>
                        <button type="button" id="statusTrigger" onclick="toggleFilterDropdown('statusPanel', event)"
                                class="flex w-full items-center justify-between px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-[14px] hover:border-indigo-300 hover:bg-slate-50 transition-all shadow-sm">
                            <span id="statusLabel" class="truncate @(statusFilter.HasValue ? "text-indigo-700 font-bold" : "text-slate-700 font-medium")">@(statusLabel ?? "Trạng thái (Tất cả)")</span>
                            <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div id="statusPanel" class="absolute left-0 top-full z-50 mt-2 hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl animate-in fade-in slide-in-from-top-2 duration-200">
                            @{ var isAllStatus = !statusFilter.HasValue; }
                            <button type="button" onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','','Trạng thái (Tất cả)', this)"
                             class="relative flex w-full items-center justify-start px-4 py-2.5 text-[13px] text-left hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0
                                filter-opt-btn @(isAllStatus ? "bg-slate-50 font-bold text-indigo-700" : "text-slate-600 font-medium")">
                                Tất cả
                            </button>
                            <button type="button" onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','1','Hoạt động', this)"
                             class="relative flex w-full items-center justify-start px-4 py-2.5 text-[13px] text-left hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0
                                filter-opt-btn @(statusFilter == 1 ? "bg-slate-50 font-bold text-indigo-700" : "text-slate-600 font-medium")">
                                Hoạt động
                            </button>
                            <button type="button" onclick="selectFilterOpt('statusPanel','statusInput','statusLabel','0','Ngừng hoạt động', this)" 
                            class="relative flex w-full items-center justify-start px-4 py-2.5 text-[13px] text-left hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0 
                                filter-opt-btn @(statusFilter == 0 ? "bg-slate-50 font-bold text-indigo-700" : "text-slate-600 font-medium")">
                                Ngừng hoạt động
                            </button>
                        </div>
                    </div>

                    @* Sort Dropdown *@
                    <input type="hidden" name="sortBy" id="sortInput" value="@sortBy" />
                    <div class="relative lg:w-48" data-filter-dropdown>
                        <button type="button" id="sortTrigger" onclick="toggleFilterDropdown('sortPanel', event)"
                                class="flex w-full items-center justify-between px-4 py-2.5 rounded-lg border border-slate-200 bg-white text-[14px] hover:border-indigo-300 hover:bg-slate-50 transition-all shadow-sm">
                            <span id="sortLabelDisplay" class="truncate @(!string.IsNullOrEmpty(sortBy) ? "text-indigo-700 font-bold" : "text-slate-700 font-medium")">@(sortLabel ?? "Sắp xếp mặc định")</span>
                            <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div id="sortPanel" class="absolute left-0 top-full z-50 mt-2 hidden w-full overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl animate-in fade-in slide-in-from-top-2 duration-200">
                            @{ var isAllSort = string.IsNullOrEmpty(sortBy); }
                            <button type="button" onclick="selectFilterOpt('sortPanel','sortInput','sortLabelDisplay','','Sắp xếp mặc định', this)" class="relative flex w-full items-center justify-start px-4 py-2.5 text-[13px] text-left hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0 filter-opt-btn @(isAllSort ? "bg-slate-50 font-bold text-indigo-700" : "text-slate-600 font-medium")">
                                Mặc định
                            </button>
                            <button type="button" onclick="selectFilterOpt('sortPanel','sortInput','sortLabelDisplay','name','Tên (A-Z)', this)" class="relative flex w-full items-center justify-start px-4 py-2.5 text-[13px] text-left hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0 filter-opt-btn @(sortBy == "name" ? "bg-slate-50 font-bold text-indigo-700" : "text-slate-600 font-medium")">
                                Tên (A-Z)
                            </button>
                            <button type="button" onclick="selectFilterOpt('sortPanel','sortInput','sortLabelDisplay','rooms','Số phòng', this)" class="relative flex w-full items-center justify-start px-4 py-2.5 text-[13px] text-left hover:bg-slate-50 transition-colors border-b border-slate-50 last:border-0 filter-opt-btn @(sortBy == "rooms" ? "bg-slate-50 font-bold text-indigo-700" : "text-slate-600 font-medium")">
                                Số phòng
                            </button>
                        </div>
                    </div>

                    @* Submit Button *@
                    <button type="submit"
                            class="flex items-center gap-2 bg-slate-900 text-white px-5 py-2.5 rounded-lg text-sm font-bold hover:bg-slate-800 transition-all active:scale-[0.98] whitespace-nowrap shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                        </svg>
                        Lọc
                    </button>

                    @* Clear Filter Button *@
                    <div id="ajax-clear-filter-wrapper">
                        @if (hasFilters)
                        {
                            <a href="/Cinemas/Index" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm h-[42px]">
                                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                                Xóa bộ lọc
                            </a>
                        }
                    </div>
                </div>

                @* Filter Chips *@
                <div id="ajax-chips-wrapper">
                    @if (hasFilters)
                    {
                        <div class="flex flex-wrap items-center gap-2 pt-2">
                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mr-2">Đang áp dụng:</span>
                            @if (!string.IsNullOrWhiteSpace(searchKeyword)) {
                                <div class="flex items-center gap-1.5 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">
                                    <span>Từ khóa: @searchKeyword</span>
                                </div>
                            }
                            @if (statusLabel != null) {
                                <div class="flex items-center gap-1.5 rounded-lg bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 border border-indigo-100">
                                    <span>@statusLabel</span>
                                </div>
                            }
                            @if (sortLabel != null) {
                                <div class="flex items-center gap-1.5 rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 border border-amber-100">
                                    <span>Sắp xếp: @sortLabel</span>
                                </div>
                            }
                            <span class="ml-1 text-xs text-slate-400">— Tìm thấy <strong class="text-slate-600">@totalItems</strong> rạp chiếu</span>
                        </div>
                    }
                </div>
            </form>
        </div>

        @* ── Cinema Cards Grid Container ── *@
        <div id="cinema-grid-container">
            <partial name="_CinemaGridPartial" model="Model" />
        </div>
    </div>
</div>

@* ── Side Drawer for Create Cinema ── *@
<partial name="_CreateDrawer" />

@* ── Side Drawer for Edit Cinema ── *@
<partial name="_EditDrawer" />

@* ── Hidden form for status toggle ── *@
<form id="statusChangeForm" method="post" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" id="statusId" name="id" />
</form>

<partial name="_StatusModals" />

@section Scripts {
    <script src="~/js/admin/cinema-index.js" asp-append-version="true"></script>
}

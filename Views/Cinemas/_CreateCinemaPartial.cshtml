@model CinemaManagement.Requests.CreateCinemaRequest

<div class="flex h-full flex-col bg-white">
    <!-- Header -->
    <div class="px-6 py-6 mt-4 overflow-hidden border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
        <div>
    <div class="px-6 pb-6 border-b border-slate-100">
        <div class="flex items-center justify-between mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 border border-indigo-100/50 shadow-sm">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
            <button type="button" onclick="toggleCinemaCreate(false)" class="p-2 rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-all">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 tracking-tight">Thêm Rạp Chiếu Mới</h3>
        <p class="text-slate-500 text-sm mt-1 leading-relaxed">Vui lòng điền thông tin bên dưới để đăng ký rạp chiếu mới.</p>
    </div>

    <!-- Body -->
    <div class="flex-1 overflow-y-auto px-6 py-8 custom-scrollbar">
        <form asp-action="Create" method="post" id="createCinemaForm" onsubmit="handleCreateSubmit(event)" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Cinema Name -->
            <div class="mb-6">
                <label asp-for="Name" class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2 ms-1">Tên Rạp Chiếu <span class="text-red-500">*</span></label>
                <div class="relative group">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-indigo-500 transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </span>
                    <input asp-for="Name" id="cinemaNameInput"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-3 pl-11 pr-11 text-sm font-medium text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-100 focus:bg-white focus:ring-2 focus:ring-indigo-100 transition-all"
                           placeholder="Ví dụ: CGV Vincom Center..." 
                           autocomplete="off" />
                    <span id="nameTickIcon" class="hidden absolute right-4 top-1/2 -translate-y-1/2 text-emerald-500 animate-in fade-in zoom-in duration-300">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </span>
                </div>
                <div id="nameFeedback" class="hidden mt-2 text-[11px] font-bold ms-1"></div>
                <span asp-validation-for="Name" class="text-danger text-[11px] font-bold mt-2 ms-1 d-block"></span>
            </div>

            <!-- Address -->
            <div class="mb-6">
                <label asp-for="Address" class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-2 ms-1">Địa Chỉ <span class="text-red-500">*</span></label>
                <div class="relative group">
                    <span class="absolute left-4 top-4 text-slate-400 group-focus-within:text-indigo-500 transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </span>
                    <textarea asp-for="Address" 
                              class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-3 pl-11 pr-4 text-sm font-medium text-slate-900 outline-none placeholder:text-slate-400 focus:border-indigo-400 focus:bg-white focus:ring-2 focus:ring-indigo-100 transition-all min-h-[120px]" 
                              placeholder="Ví dụ: 72 Lê Thánh Tôn, Quận 1..."></textarea>
                </div>
                <span asp-validation-for="Address" class="text-danger text-[11px] font-bold mt-2 ms-1 d-block"></span>
            </div>

            <div class="bg-amber-50 rounded-2xl p-4 border border-amber-100 flex gap-4 items-center shadow-sm shadow-amber-100/50">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h5 class="text-[13px] font-bold text-amber-900 mb-0.5">Lưu ý</h5>
                    <p class="text-[12px] text-amber-800/80 leading-snug mb-0 font-medium">Rạp mới mặc định ở trạng thái <span class="font-bold text-amber-900">Ngừng hoạt động</span> để kiểm duyệt trước khi mở bán.</p>
                </div>
            </div>
        </form>
    </div>

    <!-- Footer -->
    <div class="px-6 py-6 border-t border-slate-100 bg-slate-50/30 flex gap-3">
        <button type="button" onclick="toggleCinemaCreate(false)" class="flex-1 py-3.5 rounded-xl border border-slate-200 bg-slate-10 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-all active:scale-95 shadow-sm">Hủy bỏ</button>
        <button type="submit" form="createCinemaForm" id="submitCreateBtn" class="flex-1 bg-slate-900 py-3.5 rounded-xl text-sm font-bold text-white shadow-xl shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 flex align-items-center justify-center gap-2">
            <span class="spinner-border spinner-border-sm d-none" id="submitCreateSpinner" role="status" aria-hidden="true" style="width: 1rem; height: 1rem;"></span>
            <span id="submitCreateText">Tạo rạp mới</span>
        </button>
    </div>
</div>

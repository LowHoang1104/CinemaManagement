@model CinemaManagement.ViewModels.Cinema.CinemaDetailVm

<div class="modal fade" id="cinemaDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content !border-0 !rounded-[2.5rem] overflow-hidden shadow-2xl bg-white text-slate-900 font-sans p-10 relative">
            
            @* Close Button *@
            <button type="button" class="absolute top-8 right-8 text-slate-400 hover:text-slate-900 transition-colors" data-bs-dismiss="modal">
                 <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6l12 12"/></svg>
            </button>

            @* -- Header -- *@
            <div class="flex items-center gap-6 mb-8">
                <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-3xl bg-gradient-to-br from-orange-400 to-orange-600 text-white shadow-xl shadow-orange-100">
                    <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h5 class="text-3xl font-black tracking-tight text-slate-900">@Model.Name</h5>
                        
                        @* Status Pill *@
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f4f7fa] border border-slate-50">
                            @if (Model.IsActive) {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-[10px] font-black text-emerald-600">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span> HOẠT ĐỘNG
                                        </span>
                            } else {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-slate-50 text-[10px] font-black text-slate-400">
                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-300"></span> NGỪNG HOẠT ĐỘNG
                                </span>
                            }
                        </div>
                    </div>
                    <p class="text-[15px] font-medium text-slate-400 mt-1">Xem thông tin chi tiết rạp chiếu phim</p>
                </div>
            </div>

            <hr class="border-slate-100 mb-10" />

            @* -- Body Content -- *@
            <div class="space-y-10">
                
                @* ID Section *@
                <div class="flex items-start gap-2">
                    <div class="mt-1 text-slate-400">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <div>
                        <label class="block text-lg font-bold text-slate-500 mb-2">ID Rạp</label>
                        <p class="text-base font-bold text-slate-800 tracking-tight font-mono">@Model.Id</p>
                    </div>
                </div>

                @* Address Section *@
                <div class="flex items-start gap-2">
                    <div class="mt-1 text-slate-400">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </div>
                    <div>
                        <label class="block text-lg font-bold text-slate-500 mb-2">Địa chỉ</label>
                        <p class="text-base font-bold text-slate-900 leading-snug">@Model.Address</p>
                    </div>
                </div>

                @* Dates Grid *@
                <div class="grid grid-cols-2 gap-10">
                    <div class="flex items-start gap-2">
                        <div class="mt-1 text-slate-400">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <div>
                            <label class="block text-lg font-bold text-slate-500 mb-2">Ngày tạo</label>
                            @* Use Vietnamese month format *@
                            <p class="text-base font-bold text-slate-800">
                                @Model.CreatedAt.Day tháng @Model.CreatedAt.Month, @Model.CreatedAt.Year
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-2">
                        <div class="mt-1 text-slate-400">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <div>
                            <label class="block text-lg font-bold text-slate-500 mb-2">Cập nhật lần cuối</label>
                            @if (Model.UpdatedAt.HasValue) {
                                <p class="text-base font-bold text-slate-800">
                                    @Model.UpdatedAt.Value.Day tháng @Model.UpdatedAt.Value.Month, @Model.UpdatedAt.Value.Year
                                </p>
                            } else {
                                <p class="text-base font-bold text-slate-300">Chưa cập nhật</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


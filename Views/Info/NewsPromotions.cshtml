@{
    ViewData["Title"] = "Tin mới và ưu đãi";
}

<div class="page-shell">
    <section class="page-hero">
        <h1>Tin Mới Và Ưu Đãi</h1>
        <p>Cập nhật các chương trình khuyến mãi, sự kiện và ưu đãi thành viên mới nhất.</p>
    </section>

    <div class="info-grid">
        <article class="info-card">
            <h3>Thứ 3 Vui Vẻ - Đồng Giá 55K</h3>
            <div class="info-meta">Áp dụng toàn hệ thống vào thứ 3 hằng tuần.</div>
            <span class="pill">Ưu đãi vé</span>
            <span class="pill">Hội viên</span>
        </article>

        <article class="info-card">
            <h3>Combo Bắp Nước Tiết Kiệm 25%</h3>
            <div class="info-meta">Mua online trước 2 giờ chiếu để nhận giá combo ưu đãi.</div>
            <span class="pill">F&B</span>
            <span class="pill">Online</span>
        </article>

        <article class="info-card">
            <h3>Suất Chiếu Cuối Tuần Cho Gia Đình</h3>
            <div class="info-meta">Nhiều lựa chọn phim gia đình với khung giờ linh hoạt.</div>
            <span class="pill">Cuối tuần</span>
            <span class="pill">Gia đình</span>
        </article>

        <article class="info-card">
            <h3>Ưu Đãi Sinh Nhật Thành Viên</h3>
            <div class="info-meta">Tặng voucher bắp nước cho hội viên trong tháng sinh nhật.</div>
            <span class="pill">Thành viên</span>
            <span class="pill">Voucher</span>
        </article>
    </div>
</div>

@{
    ViewData["Title"] = "Nhượng quyền";
}

<div class="page-shell">
    <section class="page-hero">
        <h1>Nhượng Quyền PRIME NINE Cinema</h1>
        <p>Hợp tác phát triển cụm rạp theo mô hình tiêu chuẩn với quy trình vận hành rõ ràng.</p>
    </section>

    <div class="info-grid">
        <article class="info-card">
            <h3>1. Đánh Giá Khu Vực</h3>
            <div class="info-meta">Phân tích thị trường, mật độ dân cư và nhu cầu giải trí địa phương.</div>
        </article>

        <article class="info-card">

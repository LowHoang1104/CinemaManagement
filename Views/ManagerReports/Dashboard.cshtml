@model CinemaManagement.ViewModels.Manager.DashboardVm
@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Reports & Analytics</h4>
        <p class="text-muted mb-0 small">Revenue, bookings and occupancy statistics</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/ManagerReports/ExportExcel?from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")"
           class="btn btn-success btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>
        <a href="/ManagerReports/ExportPdf?from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")"
           target="_blank" class="btn btn-info btn-sm d-flex align-items-center gap-1 text-white">
            <i class="bi bi-printer"></i> Export PDF
        </a>
    </div>
</div>

<!-- Date Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <form class="d-flex gap-3 align-items-end flex-wrap" method="get">
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">From</label>
                <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label small fw-semibold text-muted mb-1">To</label>
                <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-funnel me-1"></i>Apply Filter
            </button>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #e50914 !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                     style="width:48px;height:48px;background:linear-gradient(135deg,#e50914,#c0392b);flex-shrink:0">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">@Model.TotalRevenue.ToString("N0")</div>
                    <div class="text-muted small">VND · Total Revenue</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #27ae60 !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                     style="width:48px;height:48px;background:linear-gradient(135deg,#27ae60,#1e8449);flex-shrink:0">
                    <i class="bi bi-ticket-perforated fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">@Model.TotalBookings.ToString("N0")</div>
                    <div class="text-muted small">Total Bookings</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #2980b9 !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                     style="width:48px;height:48px;background:linear-gradient(135deg,#2980b9,#1a5276);flex-shrink:0">
                    <i class="bi bi-person-check fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">@Model.TotalTicketsSold.ToString("N0")</div>
                    <div class="text-muted small">Tickets Sold</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #e67e22 !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                     style="width:48px;height:48px;background:linear-gradient(135deg,#e67e22,#ca6f1e);flex-shrink:0">
                    <i class="bi bi-x-circle fs-5"></i>
                </div>
                <div>
                    <div class="fw-bold fs-5">@Model.CancellationRate.ToString("F1")%</div>
                    <div class="text-muted small">Cancellation Rate (@Model.TotalCancelled)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart + Top Movies -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-graph-up me-2 text-primary"></i>Revenue by Day</h6>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-trophy me-2 text-warning"></i>Top Movies by Revenue</h6>
            </div>
            <div class="card-body p-0">
                @if (!Model.TopMovies.Any())
                {
                    <div class="text-center text-muted py-5 small">
                        <i class="bi bi-film fs-2 d-block mb-2"></i>No data for selected period.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle small">
                            <thead class="table-light">
                                <tr><th class="ps-3">#</th><th>Movie</th><th>Tickets</th><th class="pe-3">Revenue</th></tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopMovies.Count; i++)
                                {
                                    var m = Model.TopMovies[i];
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold @(i == 0 ? "text-warning" : i == 1 ? "text-secondary" : i == 2 ? "text-danger" : "text-muted")">
                                                @(i == 0 ? "🥇" : i == 1 ? "🥈" : i == 2 ? "🥉" : $"#{i + 1}")
                                            </span>
                                        </td>
                                        <td class="fw-medium">@m.Title</td>
                                        <td>@m.TicketsSold</td>
                                        <td class="pe-3 text-muted">@m.Revenue.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Occupancy Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Showtime Occupancy Rate (Top 10)</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.OccupancyRates.Any())
        {
            <div class="text-center text-muted py-5 small">
                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>No showtimes in selected period.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Movie</th>
                            <th>Start Time</th>
                            <th>Booked / Total</th>
                            <th style="min-width:200px" class="pe-4">Occupancy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.OccupancyRates)
                        {
                            var pct = s.OccupancyRate;
                            var barColor = pct >= 70 ? "#27ae60" : (pct >= 40 ? "#f39c12" : "#e74c3c");
                            var badgeClass = pct >= 70 ? "bg-success" : (pct >= 40 ? "bg-warning text-dark" : "bg-danger");
                            <tr>
                                <td class="ps-4 fw-medium">@s.MovieTitle</td>
                                <td class="text-muted small">@s.StartAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                        @s.BookedSeats / @s.TotalSeats
                                    </span>
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="flex-grow-1 rounded" style="height:8px;background:#f0f0f0;overflow:hidden">
                                            <div style="width:@((int)Math.Min(pct, 100))%;height:100%;background:@barColor;border-radius:4px;transition:width 0.4s ease"></div>
                                        </div>
                                        <span class="badge @badgeClass rounded-pill" style="min-width:46px">@pct.ToString("F0")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const labels = [@Html.Raw(string.Join(",", Model.RevenueByDay.Select(d => $"'{d.Date:dd/MM}'")))];
        const data   = [@Html.Raw(string.Join(",", Model.RevenueByDay.Select(d => d.Revenue)))];

        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Revenue (VND)',
                    data,
                    backgroundColor: 'rgba(59,130,246,0.75)',
                    borderColor: '#3b82f6',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        ticks: { callback: v => v.toLocaleString('vi-VN') + ' đ' },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
